module

public import Mathlib.GroupTheory.SemidirectProduct
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Algebra.Group.Equiv.Finite
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Data.ZMod.QuotientGroup
public import Mathlib.Data.Fintype.Prod
public import Mathlib.Algebra.Group.TypeTags.Finite
public import Mathlib.Tactic.NormNum
public import Mathlib.Tactic.IntervalCases

@[expose] public section

/-!
# Abelian groups need not have an abelian minimum cover

For a set `𝓕` of finite groups, a finite group `G` is an *`𝓕`-cover* if every member of `𝓕` is
isomorphic to a subgroup of `G`, and a *minimum* `𝓕`-cover if no `𝓕`-cover has smaller order.
P. J. Cameron, D. Craven, H. Dorbidi, S. Harper and B. Sambale, *Minimal cover groups*,
J. Algebra 660 (2024) 345–372 (arXiv:2311.15652), Question 7.2, ask:

> Let `𝓕` be a set of abelian `p`-groups. Is there a minimum `𝓕`-cover which is an abelian
> `p`-group?

and Question 8.2 asks the same for the class of abelian groups ("We have been unable to resolve
this question for abelian groups"). M.-A. Lazorec, arXiv:2602.06220 (2026), records it as open.

We answer it in the negative. Take `𝓕 = {C₂⁴, C₄ × C₄, C₈}`.

* An abelian group containing all three has order at least `2⁷ = 128`
  (`card_ge_of_commGroup`): the squaring map `x ↦ x²` has kernel containing a copy of `C₂⁴`
  (so of order `≥ 16`), and image containing an element of order 4 (the square of a generator of
  `C₈`) together with two distinct involutions (squares of the generators of `C₄ × C₄`), so of
  order `≥ 8`. (Equivalently, by Lemma 7.5 of the paper, the type would have to dominate
  `(1,1,1,1)`, `(2,2)` and `(3)`, hence `(3,2,1,1)`.)
* The group `G64 = (C₈ × C₂) ⋊ (C₂ × C₂)` of order 64 (`SmallGroup(64,99)` in GAP, i.e.
  `(C₂ × D₈) ⋊ C₄`) contains all three (`covers_G64`).

So every abelian `𝓕`-cover is strictly larger than an `𝓕`-cover that exists, and no minimum
`𝓕`-cover is abelian (`not_isMinimumCover_of_commGroup`). A GAP search shows that 64 is the least
order of a counterexample of this kind among `2`-groups (no group of order 32 contains all three,
and no group of order `≤ 32` has abelian subgroups whose types merge to more than its order).

In `G64 = N ⋊ K` with `N = C₈ × C₂ = ⟨a⟩ × ⟨b⟩` and `K = C₂ × C₂ = ⟨s⟩ × ⟨t⟩`, the action is
`s : a ↦ a³b, b ↦ b` and `t : a ↦ a⁵, b ↦ b`. Witnesses: `C₈ = ⟨a⟩`, `C₄ × C₄ = ⟨as, a²t⟩`,
`C₂⁴ = ⟨t, s, b, a⁴⟩`.
-/

namespace MinimumCover

open Function

/-- The three groups of `𝓕 = {C₂⁴, C₄ × C₄, C₈}`. -/
abbrev C2222 : Type := Multiplicative (ZMod 2 × ZMod 2 × ZMod 2 × ZMod 2)
abbrev C44 : Type := Multiplicative (ZMod 4 × ZMod 4)
abbrev C8 : Type := Multiplicative (ZMod 8)

/-- `G` is an `𝓕`-cover for `𝓕 = {C₂⁴, C₄ × C₄, C₈}`. -/
def Covers (G : Type*) [Group G] : Prop :=
  (∃ f : C2222 →* G, Injective f) ∧ (∃ f : C44 →* G, Injective f) ∧
    (∃ f : C8 →* G, Injective f)

/-! ### Lower bound for abelian covers -/

/-- In a cyclic group generated by `c` of order 4, the only involution is `c²`. -/
theorem eq_sq_of_mem_zpowers {A : Type*} [Group A] {c w : A} (hc : orderOf c = 4)
    (hw : w ∈ Subgroup.zpowers c) (hw1 : w ≠ 1) (hw2 : w ^ 2 = 1) : w = c ^ 2 := by
  classical
  have hfin : IsOfFinOrder c := orderOf_pos_iff.1 (by rw [hc]; norm_num)
  rw [hfin.mem_zpowers_iff_mem_range_orderOf, hc] at hw
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.1 hw
  have hn4 : n < 4 := Finset.mem_range.1 hn
  interval_cases n
  · simp at hw1
  · exfalso
    have := orderOf_dvd_of_pow_eq_one (by simpa using hw2)
    rw [hc] at this; norm_num at this
  · rfl
  · exfalso
    have := orderOf_dvd_of_pow_eq_one (by rw [← pow_mul] at hw2; exact hw2)
    rw [hc] at this; norm_num at this

/-- **Abelian covers are large**: a finite abelian group containing `C₂⁴`, `C₄ × C₄` and `C₈`
has order at least `128`. -/
theorem card_ge_of_commGroup (A : Type*) [CommGroup A] [Finite A] (hA : Covers A) :
    128 ≤ Nat.card A := by
  obtain ⟨⟨f, hf⟩, ⟨h, hh⟩, ⟨g, hg⟩⟩ := hA
  set φ : A →* A := powMonoidHom 2
  -- `|A| = |ker φ| · |range φ|`
  have hcard : Nat.card A = Nat.card φ.ker * Nat.card φ.range := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker, mul_comm,
      Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv]
  -- the kernel contains a copy of `C₂⁴`
  have hker : 16 ≤ Nat.card φ.ker := by
    have hsq : ∀ x : C2222, x ^ 2 = 1 := by decide
    let e : C2222 → φ.ker := fun x =>
      ⟨f x, by simp [φ, MonoidHom.mem_ker, ← map_pow, hsq]⟩
    have he : Injective e := fun x y hxy => hf (congrArg Subtype.val hxy)
    have := Nat.card_le_card_of_injective e he
    rwa [show Nat.card C2222 = 16 by rw [Nat.card_eq_fintype_card]; rfl] at this
  -- the image contains an element of order 4 and two distinct involutions
  have hrange : 8 ≤ Nat.card φ.range := by
    set c : A := g (Multiplicative.ofAdd 1) ^ 2
    have hc : orderOf c = 4 := by
      have h8 : orderOf (Multiplicative.ofAdd (1 : ZMod 8)) = 8 := by
        rw [orderOf_ofAdd_eq_addOrderOf]; exact ZMod.addOrderOf_one 8
      have : orderOf (g (Multiplicative.ofAdd 1)) = 8 := by
        rw [orderOf_injective g hg, h8]
      simp only [c]
      rw [orderOf_pow' _ (by norm_num), this]; rfl
    have hcR : c ∈ φ.range := ⟨_, rfl⟩
    have hle : Subgroup.zpowers c ≤ φ.range := (Subgroup.zpowers_le).2 hcR
    have h4 : Nat.card (Subgroup.zpowers c) = 4 := by rw [Nat.card_zpowers, hc]
    have hdvd : 4 ∣ Nat.card φ.range := h4 ▸ Subgroup.card_dvd_of_le hle
    have hpos : 0 < Nat.card φ.range := Nat.card_pos
    have hne : Nat.card φ.range ≠ 4 := by
      intro h4'
      have heq : Subgroup.zpowers c = φ.range :=
        Subgroup.eq_of_le_of_card_ge hle (by rw [h4, h4'])
      set u : C44 := Multiplicative.ofAdd (1, 0)
      set v : C44 := Multiplicative.ofAdd (0, 1)
      have key : ∀ x : C44, x ^ 4 = 1 ∧ (x ^ 2 ≠ 1 → h x ^ 2 ≠ 1) := by
        intro x
        refine ⟨by revert x; decide, fun hx hx' => hx (hh ?_)⟩
        rw [map_pow, hx', map_one]
      have mem : ∀ x : C44, h x ^ 2 = c ^ 2 ∨ x ^ 2 = 1 := by
        intro x
        by_cases hx : x ^ 2 = 1
        · exact Or.inr hx
        · left
          refine eq_sq_of_mem_zpowers hc (heq ▸ ⟨h x, rfl⟩) ((key x).2 hx) ?_
          rw [← pow_mul, ← map_pow, (key x).1, map_one]
      have hu : u ^ 2 ≠ 1 := by decide
      have hv : v ^ 2 ≠ 1 := by decide
      have huv : u ^ 2 ≠ v ^ 2 := by decide
      have h1 := (mem u).resolve_right hu
      have h2 := (mem v).resolve_right hv
      exact huv (hh (by rw [map_pow, map_pow, h1, h2]))
    omega
  rw [hcard]
  calc 128 = 16 * 8 := by norm_num
    _ ≤ _ := Nat.mul_le_mul hker hrange

/-! ### The group `SmallGroup(64,99)` -/

/-- `N = C₈ × C₂`. -/
abbrev N : Type := Multiplicative (ZMod 8 × ZMod 2)
/-- `K = C₂ × C₂`. -/
abbrev K : Type := Multiplicative (ZMod 2 × ZMod 2)

/-- `s : (x, y) ↦ (3x, x + y)` (i.e. `a ↦ a³b`, `b ↦ b`), an involutive automorphism of `N`. -/
def sAut : MulAut N where
  toFun n := Multiplicative.ofAdd (3 * n.toAdd.1, ((n.toAdd.1.val : ℕ) : ZMod 2) + n.toAdd.2)
  invFun n := Multiplicative.ofAdd (3 * n.toAdd.1, ((n.toAdd.1.val : ℕ) : ZMod 2) + n.toAdd.2)
  left_inv := by decide +kernel
  right_inv := by decide +kernel
  map_mul' := by decide +kernel

/-- `t : (x, y) ↦ (5x, y)` (i.e. `a ↦ a⁵`, `b ↦ b`), an involutive automorphism of `N`. -/
def tAut : MulAut N where
  toFun n := Multiplicative.ofAdd (5 * n.toAdd.1, n.toAdd.2)
  invFun n := Multiplicative.ofAdd (5 * n.toAdd.1, n.toAdd.2)
  left_inv := by decide +kernel
  right_inv := by decide +kernel
  map_mul' := by decide +kernel

/-- The action `K → Aut N`, `(u, v) ↦ sᵘ tᵛ`. -/
def act : K →* MulAut N where
  toFun k := (if k.toAdd.1 = 1 then sAut else 1) * (if k.toAdd.2 = 1 then tAut else 1)
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

/-- `G64 = (C₈ × C₂) ⋊ (C₂ × C₂)`, isomorphic to `SmallGroup(64,99)`. -/
abbrev G64 : Type := N ⋊[act] K

instance : Finite G64 := Finite.of_equiv _ SemidirectProduct.equivProd.symm

instance : DecidableEq G64 := fun x y =>
  decidable_of_iff (x.left = y.left ∧ x.right = y.right) SemidirectProduct.ext_iff.symm

theorem card_G64 : Nat.card G64 = 64 := by
  rw [SemidirectProduct.card, Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]; rfl

/-- `G64` is not abelian (so it is a genuinely non-abelian minimum cover). -/
theorem G64_not_comm : ∃ x y : G64, x * y ≠ y * x :=
  ⟨⟨Multiplicative.ofAdd (1, 0), 1⟩, ⟨1, Multiplicative.ofAdd (0, 1)⟩, by decide +kernel⟩

/-- Element `⟨n, k⟩` of `G64` from additive coordinates. -/
def mk (x : ZMod 8) (y : ZMod 2) (u v : ZMod 2) : G64 :=
  ⟨Multiplicative.ofAdd (x, y), Multiplicative.ofAdd (u, v)⟩

/-- `C₈ = ⟨a⟩`. -/
def embC8 : C8 →* G64 where
  toFun z := mk 1 0 0 0 ^ z.toAdd.val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

/-- `C₄ × C₄ = ⟨as, a²t⟩`. -/
def embC44 : C44 →* G64 where
  toFun z := mk 1 0 1 0 ^ z.toAdd.1.val * mk 2 0 0 1 ^ z.toAdd.2.val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

/-- `C₂⁴ = ⟨t, s, b, a⁴⟩`. -/
def embC2222 : C2222 →* G64 where
  toFun z := mk 0 0 0 1 ^ z.toAdd.1.val * mk 0 0 1 0 ^ z.toAdd.2.1.val *
    mk 0 1 0 0 ^ z.toAdd.2.2.1.val * mk 4 0 0 0 ^ z.toAdd.2.2.2.val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

theorem covers_G64 : Covers G64 :=
  ⟨⟨embC2222, by decide +kernel⟩, ⟨embC44, by decide +kernel⟩, ⟨embC8, by decide +kernel⟩⟩

/-! ### The answer to Cameron–Craven–Dorbidi–Harper–Sambale, Question 7.2 / 8.2 -/

/-- `G` is a minimum `𝓕`-cover (among groups in the same universe). -/
def IsMinimumCover (G : Type) [Group G] [Finite G] : Prop :=
  Covers G ∧ ∀ (H : Type) [Group H] [Finite H], Covers H → Nat.card G ≤ Nat.card H

/-- Every abelian `𝓕`-cover is strictly larger than the `𝓕`-cover `G64`. -/
theorem card_G64_lt_of_commGroup (A : Type*) [CommGroup A] [Finite A] (hA : Covers A) :
    Nat.card G64 < Nat.card A := by
  have := card_ge_of_commGroup A hA
  rw [card_G64]; omega

/-- **No minimum `{C₂⁴, C₄ × C₄, C₈}`-cover is abelian.** This answers Question 7.2 (and the
abelian case of Question 8.2) of Cameron–Craven–Dorbidi–Harper–Sambale in the negative. -/
theorem not_isMinimumCover_of_commGroup (A : Type) [CommGroup A] [Finite A] :
    ¬ IsMinimumCover A := by
  rintro ⟨hA, hmin⟩
  have := hmin G64 covers_G64
  have := card_G64_lt_of_commGroup A hA
  omega

end MinimumCover
