/-- **No perfect cuboid has two edges in ratio `20 : 99`.** This is the fiber `(m, n) = (10, 1)`:
with `X = 20k`, `Z = 99k`, the face diagonal `√(Y² + 9801k²)` and the space diagonal
`√(Y² + 10201k²)` cannot both be integers. -/
theorem not_isPerfectCuboid_twenty_ninetynine {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    99 * X ≠ 20 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 20 ∣ X := by omega
  obtain rfl : Z = 99 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_bc
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_ninetynine_101 (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (99 * k) ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((20 * k) ^ 2 + Y ^ 2 + (99 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
