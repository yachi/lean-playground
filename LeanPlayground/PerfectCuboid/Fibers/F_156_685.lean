with `X = 156k`, `Z = 667k`, the face diagonal `√(Y² + 24336k²)` and the space diagonal
`√(Y² + 469225k²)` cannot both be integers. -/
theorem not_isPerfectCuboid_156_667 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    667 * X ≠ 156 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 156 ∣ X := by omega
  obtain rfl : Z = 667 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_ab
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_156_685 (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : (((156 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((156 * k) ^ 2 + Y ^ 2 + (667 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
