theorem not_isPerfectCuboid_forty_399 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    399 * X ≠ 40 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 40 ∣ X := by omega
  obtain rfl : Z = 399 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_ab
  obtain ⟨t, ht⟩ := h.sq_bc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_forty_399 (Y : ℤ) k r t
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : (((40 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : ((Y ^ 2 + (399 * k) ^ 2 : ℕ) : ℤ) = ((t * t : ℕ) : ℤ) := by rw [ht]
    push_cast at this
    linear_combination this

end PerfectCuboid
