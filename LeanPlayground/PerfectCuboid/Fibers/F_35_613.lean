theorem not_isSquare_sq_add_1225_and_sq_add_375769 {t : ℚ} (ht : t ≠ 0) :
    ¬ (IsSquare (t ^ 2 + 1225) ∧ IsSquare (t ^ 2 + 375769)) := by
  have := Descent.not_isSquare_sq_add_sq_and_sq_add_sq (p := 35) (q := 613) (a := 612)
    (by norm_num) (by norm_num) (by norm_num) (by decide)
    Descent.covered_thirtyfive_613 ht
  norm_num at this
  exact fun h ↦ this h.1 h.2

/-- **No perfect cuboid has two edges in ratio `35 : 612`.** This is the fiber `(m, n) = (18, 17)`:
with `X = 612k`, `Z = 35k`, the face diagonal `√(Y² + 1225k²)` and the space diagonal
`√(Y² + 375769k²)` cannot both be integers. -/
theorem not_isPerfectCuboid_thirtyfive_612 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    35 * X ≠ 612 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 612 ∣ X := by omega
  obtain rfl : Z = 35 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_bc
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_thirtyfive_613 (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (35 * k) ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((612 * k) ^ 2 + Y ^ 2 + (35 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
