/-- For rational `t ≠ 0`, `t² + 441` and `t² + 841` are not both squares. -/
theorem not_isSquare_sq_add_441_and_sq_add_841 {t : ℚ} (ht : t ≠ 0) :
    ¬ (IsSquare (t ^ 2 + 441) ∧ IsSquare (t ^ 2 + 841)) := by
  have := Descent.not_isSquare_sq_add_sq_and_sq_add_sq (p := 21) (q := 29) (a := 20)
    (by norm_num) (by norm_num) (by norm_num) (by decide)
    Descent.covered_twentyone_twentynine ht
  norm_num at this
  exact fun h ↦ this h.1 h.2

/-- **No perfect cuboid has two edges in ratio `20 : 21`.** This is the fiber `(m, n) = (5, 2)`:
with `X = 20k`, `Z = 21k`, the face diagonal `√(Y² + 441k²)` and the space diagonal `√(Y² + 841k²)`
cannot both be integers. -/
theorem not_isPerfectCuboid_twenty_twentyone {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    21 * X ≠ 20 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 20 ∣ X := by omega
  obtain rfl : Z = 21 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_bc
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_twentyone_twentynine (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (21 * k) ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((20 * k) ^ 2 + Y ^ 2 + (21 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
