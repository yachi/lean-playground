/-- **No perfect cuboid has two edges in ratio `52 : 165`.** This is the fiber `(m, n) = (13, 2)`:
with `X = 52k`, `Z = 165k`, the face diagonal `√(Y² + 2704k²)` and the space diagonal
`√(Y² + 29929k²)` cannot both be integers. -/
theorem not_isPerfectCuboid_fiftytwo_165 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    165 * X ≠ 52 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 52 ∣ X := by omega
  obtain rfl : Z = 165 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_ab
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_fiftytwo_173 (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : (((52 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((52 * k) ^ 2 + Y ^ 2 + (165 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
