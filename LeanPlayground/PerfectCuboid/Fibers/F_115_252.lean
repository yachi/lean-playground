/-- **No perfect cuboid has two edges in ratio `115 : 252`.** This is the fiber `(m, n) = (14, 9)`:
with `X = 252k`, `Z = 115k`, the face diagonals `√(Y² + 13225k²)` and `√(Y² + 63504k²)` cannot both
be integers. -/
theorem not_isPerfectCuboid_115_252 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    115 * X ≠ 252 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 252 ∣ X := by omega
  obtain rfl : Z = 115 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_ab
  obtain ⟨t, ht⟩ := h.sq_bc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_115_252 (Y : ℤ) k t r
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (115 * k) ^ 2 : ℕ) : ℤ) = ((t * t : ℕ) : ℤ) := by rw [ht]
    push_cast at this
    linear_combination this
  · have : (((252 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this

end PerfectCuboid
