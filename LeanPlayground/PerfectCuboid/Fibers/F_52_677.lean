/-- For rational `t ≠ 0`, `t² + 2704` and `t² + 458329` are not both squares. -/
theorem not_isSquare_sq_add_2704_and_sq_add_458329 {t : ℚ} (ht : t ≠ 0) :
    ¬ (IsSquare (t ^ 2 + 2704) ∧ IsSquare (t ^ 2 + 458329)) := by
  have := Descent.not_isSquare_sq_add_sq_and_sq_add_sq (p := 52) (q := 677) (a := 675)
    (by norm_num) (by norm_num) (by norm_num) (by decide)
    Descent.covered_fiftytwo_677 ht
  norm_num at this
  exact fun h ↦ this h.1 h.2

/-- **No perfect cuboid has two edges in ratio `52 : 675`.** This is the fiber `(m, n) = (26, 1)`:
with `X = 52k`, `Z = 675k`, the face diagonal `√(Y² + 2704k²)` and the space diagonal
`√(Y² + 458329k²)` cannot both be integers. -/
theorem not_isPerfectCuboid_fiftytwo_675 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    675 * X ≠ 52 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 52 ∣ X := by omega
  obtain rfl : Z = 675 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_ab
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_fiftytwo_677 (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : (((52 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((52 * k) ^ 2 + Y ^ 2 + (675 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
