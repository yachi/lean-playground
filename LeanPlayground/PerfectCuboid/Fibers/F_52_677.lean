/-- The fiber `(m, n) = (26, 1)`: the descent for `(p, q) = (52, 677)`. -/
theorem not_isSol_fiftytwo_677 (M e r s : ℤ) : ¬ IsSol 52 677 M e r s := by
  simpa using not_isSol (p := 52) (q := 677) (a := 675) (by norm_num) (by norm_num)
