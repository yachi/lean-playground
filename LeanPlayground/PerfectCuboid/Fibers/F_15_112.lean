theorem not_isPerfectCuboid_fifteen_112 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    15 * X ≠ 112 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 112 ∣ X := by omega
  obtain rfl : Z = 15 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_ab
  obtain ⟨t, ht⟩ := h.sq_bc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_fifteen_112 (Y : ℤ) k t r
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (15 * k) ^ 2 : ℕ) : ℤ) = ((t * t : ℕ) : ℤ) := by rw [ht]
    push_cast at this
    linear_combination this
  · have : (((112 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this

end PerfectCuboid
