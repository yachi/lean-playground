/-- **No perfect cuboid has two edges in ratio `297 : 304`.** This is the fiber `(m, n) = (19, 8)`:
with `X = 304k`, `Z = 297k`, the face diagonal `√(Y² + 88209k²)` and the space diagonal
`√(Y² + 180625k²)` cannot both be integers. -/
theorem not_isPerfectCuboid_297_304 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    297 * X ≠ 304 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 304 ∣ X := by omega
  obtain rfl : Z = 297 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_bc
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_297_425 (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (297 * k) ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((304 * k) ^ 2 + Y ^ 2 + (297 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
