/-- **No perfect cuboid has two edges in ratio `276 : 493`.** This is the fiber `(m, n) = (23, 6)`:
with `X = 276k`, `Z = 493k`, the face diagonal `√(Y² + 243049k²)` and the space diagonal
`√(Y² + 319225k²)` cannot both be integers. -/
theorem not_isPerfectCuboid_276_493 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    493 * X ≠ 276 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 276 ∣ X := by omega
  obtain rfl : Z = 493 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_bc
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_493_565 (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (493 * k) ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((276 * k) ^ 2 + Y ^ 2 + (493 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
