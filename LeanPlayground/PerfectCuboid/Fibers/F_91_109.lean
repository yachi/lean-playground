/-- **No perfect cuboid has two edges in ratio `60 : 91`.** This is the fiber `(m, n) = (10, 3)`:
with `X = 60k`, `Z = 91k`, the face diagonal `√(Y² + 8281k²)` and the space diagonal
`√(Y² + 11881k²)` cannot both be integers. -/
theorem not_isPerfectCuboid_sixty_ninetyone {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    91 * X ≠ 60 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 60 ∣ X := by omega
  obtain rfl : Z = 91 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_bc
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_ninetyone_109 (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (91 * k) ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((60 * k) ^ 2 + Y ^ 2 + (91 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
