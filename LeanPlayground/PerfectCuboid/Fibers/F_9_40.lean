/-- **No perfect cuboid has two edges in ratio `9 : 40`.** This is the fiber `(m, n) = (5, 4)`: with
`X = 40k`, `Z = 9k`, the face diagonals `√(Y² + 81k²)` and `√(Y² + 1600k²)` cannot both be integers.
-/
theorem not_isPerfectCuboid_nine_forty {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    9 * X ≠ 40 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 40 ∣ X := by omega
  obtain rfl : Z = 9 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_ab
  obtain ⟨t, ht⟩ := h.sq_bc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_nine_forty (Y : ℤ) k t r
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (9 * k) ^ 2 : ℕ) : ℤ) = ((t * t : ℕ) : ℤ) := by rw [ht]
    push_cast at this
    linear_combination this
  · have : (((40 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this

end PerfectCuboid
