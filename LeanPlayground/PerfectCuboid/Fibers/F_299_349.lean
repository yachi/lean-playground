  have := Descent.not_isSquare_sq_add_sq_and_sq_add_sq (p := 299) (q := 349) (a := 180)
    (by norm_num) (by norm_num) (by norm_num) (by decide)
    Descent.covered_299_349 ht
  norm_num at this
  exact fun h ↦ this h.1 h.2

/-- **No perfect cuboid has two edges in ratio `180 : 299`.** This is the fiber `(m, n) = (18, 5)`:
with `X = 180k`, `Z = 299k`, the face diagonal `√(Y² + 89401k²)` and the space diagonal
`√(Y² + 121801k²)` cannot both be integers. -/
theorem not_isPerfectCuboid_180_299 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    299 * X ≠ 180 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 180 ∣ X := by omega
  obtain rfl : Z = 299 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_bc
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_299_349 (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (299 * k) ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((180 * k) ^ 2 + Y ^ 2 + (299 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
