/-- **No perfect cuboid has two edges in ratio `231 : 520`.** This is the fiber `(m, n) = (20, 13)`:
with `X = 520k`, `Z = 231k`, the face diagonals `√(Y² + 53361k²)` and `√(Y² + 270400k²)` cannot both
be integers. -/
theorem not_isPerfectCuboid_231_520 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    231 * X ≠ 520 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 520 ∣ X := by omega
  obtain rfl : Z = 231 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_ab
  obtain ⟨t, ht⟩ := h.sq_bc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_231_520 (Y : ℤ) k t r
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (231 * k) ^ 2 : ℕ) : ℤ) = ((t * t : ℕ) : ℤ) := by rw [ht]
    push_cast at this
    linear_combination this
  · have : (((520 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this

end PerfectCuboid
