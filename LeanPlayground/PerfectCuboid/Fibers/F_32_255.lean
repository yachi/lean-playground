/-- **No perfect cuboid has two edges in ratio `32 : 255`.** This is the fiber `(m, n) = (16, 1)`:
with `X = 32k`, `Z = 255k`, the face diagonals `√(Y² + 65025k²)` and `√(Y² + 1024k²)` cannot both be
integers. -/
theorem not_isPerfectCuboid_thirtytwo_255 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    255 * X ≠ 32 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 32 ∣ X := by omega
  obtain rfl : Z = 255 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_ab
  obtain ⟨t, ht⟩ := h.sq_bc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_thirtytwo_255 (Y : ℤ) k r t
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : (((32 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : ((Y ^ 2 + (255 * k) ^ 2 : ℕ) : ℤ) = ((t * t : ℕ) : ℤ) := by rw [ht]
    push_cast at this
    linear_combination this

end PerfectCuboid
