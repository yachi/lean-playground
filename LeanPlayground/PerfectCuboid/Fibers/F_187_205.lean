  norm_num at this
  exact fun h ↦ this h.1 h.2

/-- **No perfect cuboid has two edges in ratio `84 : 187`.** This is the fiber `(m, n) = (14, 3)`:
with `X = 84k`, `Z = 187k`, the face diagonal `√(Y² + 34969k²)` and the space diagonal
`√(Y² + 42025k²)` cannot both be integers. -/
theorem not_isPerfectCuboid_eightyfour_187 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    187 * X ≠ 84 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 84 ∣ X := by omega
  obtain rfl : Z = 187 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_bc
  obtain ⟨s, hs⟩ := h.sq_abc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_187_205 (Y : ℤ) k r s
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (187 * k) ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this
  · have : (((84 * k) ^ 2 + Y ^ 2 + (187 * k) ^ 2 : ℕ) : ℤ) = ((s * s : ℕ) : ℤ) := by rw [hs]
    push_cast at this
    linear_combination this

end PerfectCuboid
