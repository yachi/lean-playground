  simpa using not_isSolD (p := 279) (q := 440) (D := 115759) (by norm_num) (by norm_num)
    (by norm_num) (by decide) covered_279_440 M e r s

end Descent

/-- For rational `t ≠ 0`, `t² + 77841` and `t² + 193600` are not both squares. -/
theorem not_isSquare_sq_add_77841_and_sq_add_193600 {t : ℚ} (ht : t ≠ 0) :
    ¬ (IsSquare (t ^ 2 + 77841) ∧ IsSquare (t ^ 2 + 193600)) := by
  have := Descent.not_isSquare_sq_add_sq_and_sq_add_sqD (p := 279) (q := 440)
    (D := 115759) (by norm_num) (by norm_num) (by norm_num) (by decide)
    Descent.covered_279_440 ht
  norm_num at this
  exact fun h ↦ this h.1 h.2

/-- **No perfect cuboid has two edges in ratio `279 : 440`.** This is the fiber `(m, n) = (20, 11)`:
with `X = 440k`, `Z = 279k`, the face diagonals `√(Y² + 77841k²)` and `√(Y² + 193600k²)` cannot both
be integers. -/
theorem not_isPerfectCuboid_279_440 {X Y Z : ℕ} (h : IsPerfectCuboid X Y Z) :
    279 * X ≠ 440 * Z := by
  intro hXZ
  obtain ⟨k, rfl⟩ : 440 ∣ X := by omega
  obtain rfl : Z = 279 * k := by omega
  obtain ⟨r, hr⟩ := h.sq_ab
  obtain ⟨t, ht⟩ := h.sq_bc
  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_279_440 (Y : ℤ) k t r
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (279 * k) ^ 2 : ℕ) : ℤ) = ((t * t : ℕ) : ℤ) := by rw [ht]
    push_cast at this
    linear_combination this
  · have : (((440 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this

end PerfectCuboid
