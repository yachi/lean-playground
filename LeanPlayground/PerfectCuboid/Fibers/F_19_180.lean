  have hY := h.pos_b
  have hk : 0 < k := by have := h.pos_a; omega
  apply Descent.not_isSol_nineteen_180 (Y : ℤ) k t r
  refine ⟨by exact_mod_cast hY.ne', by exact_mod_cast hk.ne', ?_, ?_⟩
  · have : ((Y ^ 2 + (19 * k) ^ 2 : ℕ) : ℤ) = ((t * t : ℕ) : ℤ) := by rw [ht]
    push_cast at this
    linear_combination this
  · have : (((180 * k) ^ 2 + Y ^ 2 : ℕ) : ℤ) = ((r * r : ℕ) : ℤ) := by rw [hr]
    push_cast at this
    linear_combination this

end PerfectCuboid
