/-!
# The third cuboid polynomial is irreducible on ≈ 94.8% of all triples

Sharipov's third cuboid conjecture (see `LeanPlayground.PerfectCuboid.ThirdConjecture`) says that
`cuboidThreePoly a b c` is irreducible in `ℤ[X]`. `LeanPlayground.PerfectCuboid.ThirdConjecture1317`
proves this for `≈ 2.73%` of the residue classes of `(a, b, c)` with two primes. This file uses the
seventeen primes `13 ≤ p ≤ 79`.

**Many-prime criterion** (`irreducible_of_checkB`). If `cuboidThreePoly a b c = u v` with `u`
monic of degree `d`, then for every prime `p` the reduction of `u` divides the reduction of the
polynomial, so `d` is a subset sum of the degrees of its irreducible factors modulo `p`. If these
sets of subset sums for `p₁, …, pₖ` meet only in `0` and `12`, the polynomial is irreducible. The
check `checkB` intersects them; for each prime it looks up the class of `(a, b, c)` in a
certified table (`lookupSums`), keyed by a normal form (`normKey`) and confirmed by a scale
`t ∈ {a, b, c}` (`matchB`, see `LeanPlayground.PerfectCuboid.ThirdConjectureCert`).

**Tables** (`LeanPlayground.PerfectCuboid.ThirdConjectureTables.T13`, …, `T79`, generated by
`scripts/third_cuboid/gen_tables.py`). For each prime, one entry for every class of `(a², b², c²)`
up to nonzero squares and swapping `a, b` whose subset sums are not all of `0, …, 12`: 4880
entries in all, each with the factorization at a representative and irreducibility certificates,
checked by the kernel (`decide +kernel`).

**Main theorem** (`irreducible_cuboidThreePoly_of_checkB`). If `checkB certTables a b c = true`
then `cuboidThreePoly a b c` is irreducible in `ℤ[X]`. No positivity, coprimality or distinctness
of `a, b, c` is needed. The check depends only on `(a, b, c)` modulo
`N = 13 · 17 · ⋯ · 79`, and succeeds on a proportion `≈ 0.947728` of the triples modulo `N`
(computed exactly, as a product over the primes, by
`scripts/third_cuboid/coverage.py`). For comparison: `2.73%` with `(13, 17)` alone, `≈ 30%` with
the primes up to `29`, `≈ 69%` up to `43`, `≈ 88%` up to `61`. The remaining classes are mostly
those where every prime allows a `6 + 6` splitting.

Examples: `(1, 2, 3)`, `(2, 3, 5)`, `(3, 5, 7)` (`irreducible_cuboidThreePoly_one_two_three'`,
…), each a single kernel evaluation of `checkB`.
-/

@[expose] public section

namespace PerfectCuboid.ThirdConjecture.ModP

open Polynomial Tables

/-! ### Lookup and the many-prime check -/

/-- A normal form of the class of `(a², b², c²)` modulo `p` up to nonzero squares and swapping
`a, b` (used only to find the entry). -/
def normKey (p : ℕ) (a b c : ℤ) : ℕ × ℕ × ℕ :=
  let A := sqMod p a
  let B := sqMod p b
  let C := sqMod p c
  if C != 0 then
    let u := invP p C
    let x := A * u % p
    let y := B * u % p
    (min x y, max x y, 1)
  else if A == 0 then (0, if B == 0 then 0 else 1, 0)
  else if B == 0 then (0, 1, 0)
  else (min (A * invP p B % p) (B * invP p A % p), 1, 0)

/-- The subset sums of the degree pattern modulo `p` for `(a, b, c)`, from the table entry with
key `k` (`normKey p a b c` in `interK`); all of `0, …, 12` if there is none. -/
def lookupSums (p : ℕ) (tbl : List Entry) (a b c : ℤ) (k : ℕ × ℕ × ℕ) : List ℕ :=
  match tbl.find? (fun e ↦ e.1 == k && matchB p a b c e) with
  | some e => sums (degs e.facs)
  | none => List.range 13

theorem natDegree_mem_lookupSums {p : ℕ} [Fact p.Prime] {tbl : List Entry}
    (htbl : tbl.all (entryOK p) = true) (a b c : ℤ) (u : ℤ[X]) (hu : u.Monic)
    (hdvd : u ∣ cuboidThreePoly a b c) (k : ℕ × ℕ × ℕ) :
    u.natDegree ∈ lookupSums p tbl a b c k := by
  have hmap : u.map (Int.castRingHom (ZMod p)) ∣
      (cuboidThreePoly a b c).map (Int.castRingHom (ZMod p)) := Polynomial.map_dvd _ hdvd
  rw [lookupSums]
  split
  · rename_i e he
    have hmem := List.mem_of_find?_eq_some he
    have hpe := List.find?_some he
    simp only [Bool.and_eq_true] at hpe
    have hok := List.all_eq_true.1 htbl e hmem
    rw [← hu.natDegree_map (Int.castRingHom (ZMod p))]
    simp only [matchB, Bool.or_eq_true] at hpe
    rcases hpe.2 with (h | h) | h
    · exact natDegree_mem_of_matchT hok h _ hmap
    · exact natDegree_mem_of_matchT hok h _ hmap
    · exact natDegree_mem_of_matchT hok h _ hmap
  · have h12 : u.natDegree ≤ 12 := by
      rw [← natDegree_cuboidThreePoly a b c]
      exact natDegree_le_of_dvd hdvd (monic_cuboidThreePoly a b c).ne_zero
    simp only [List.mem_range]; omega

/-- Intersect the subset sums over the tables, then call `k`. -/
def interK (a b c : ℤ) (k : List ℕ → Bool) : List (ℕ × List Entry) → List ℕ → Bool
  | [], acc => k acc
  | pt :: cs, acc =>
    withN (normKey pt.1 a b c).1 fun k₁ ↦ withN (normKey pt.1 a b c).2.1 fun k₂ ↦
      withN (normKey pt.1 a b c).2.2 fun k₃ ↦
        forceL (lookupSums pt.1 pt.2 a b c (k₁, k₂, k₃)) fun m ↦
          forceL (acc.filter fun d ↦ m.contains d) fun acc' ↦ interK a b c k cs acc'

theorem exists_of_interK {a b c : ℤ} {k : List ℕ → Bool} :
    ∀ cs acc, interK a b c k cs acc = true → ∃ acc', k acc' = true ∧
      ∀ d ∈ acc, (∀ pt ∈ cs, ∀ k, d ∈ lookupSums pt.1 pt.2 a b c k) → d ∈ acc'
  | [], acc, h => ⟨acc, h, fun _ hd _ ↦ hd⟩
  | pt :: cs, acc, h => by
    rw [interK, withN_eq, withN_eq, withN_eq, forceL_eq, forceL_eq] at h
    obtain ⟨acc', hk, hacc⟩ := exists_of_interK cs _ h
    refine ⟨acc', hk, fun d hd hall ↦ hacc d ?_ fun pt' hpt' ↦ hall pt' (by simp [hpt'])⟩
    simp only [List.mem_filter, List.contains_iff_mem]
    exact ⟨hd, hall pt (by simp) _⟩

/-- **The many-prime check**: the subset sums modulo all primes of `cs` meet only in `0, 12`. -/
def checkB (cs : List (ℕ × List Entry)) (a b c : ℤ) : Bool :=
  interK a b c (fun acc ↦ acc.all fun d ↦ d == 0 || d == 12) cs (List.range 13)

/-- **Many-prime criterion.** If each table of `cs` is certified for its prime and `checkB`
succeeds, then `cuboidThreePoly a b c` is irreducible in `ℤ[X]`. -/
theorem irreducible_of_checkB {cs : List (ℕ × List Entry)}
    (hcs : ∀ pt ∈ cs, pt.1.Prime ∧ pt.2.all (entryOK pt.1) = true) {a b c : ℤ}
    (h : checkB cs a b c = true) : Irreducible (cuboidThreePoly a b c) := by
  have hm := monic_cuboidThreePoly a b c
  rw [hm.irreducible_iff_natDegree]
  refine ⟨fun h1 ↦ by
    have := natDegree_cuboidThreePoly a b c
    rw [h1, natDegree_one] at this; omega, fun f g hf hg hfg ↦ ?_⟩
  obtain ⟨acc', hk, hacc⟩ := exists_of_interK cs _ h
  have hle : f.natDegree ≤ 12 := by
    rw [← natDegree_cuboidThreePoly a b c, ← hfg, hf.natDegree_mul hg]; omega
  have hd := hacc f.natDegree (by simp only [List.mem_range]; omega) fun pt hpt k ↦ by
    have := (hcs pt hpt).1
    have : Fact pt.1.Prime := ⟨this⟩
    exact natDegree_mem_lookupSums (hcs pt hpt).2 a b c f hf ⟨g, hfg.symm⟩ k
  have := List.all_eq_true.1 hk _ hd
  simp only [Bool.or_eq_true, beq_iff_eq] at this
  rcases this with h0 | h12
  · exact Or.inl h0
  · have h' := natDegree_cuboidThreePoly a b c
    rw [← hfg, hf.natDegree_mul hg] at h'
    exact Or.inr (by omega)

/-! ### The tables for `13 ≤ p ≤ 79` -/

/-- The certified tables, one for each prime `13 ≤ p ≤ 79`. -/
def certTables : List (ℕ × List Entry) :=
  [(13, table13), (17, table17), (19, table19), (23, table23), (29, table29),
    (31, table31), (37, table37), (41, table41), (43, table43), (47, table47),
    (53, table53), (59, table59), (61, table61), (67, table67), (71, table71),
    (73, table73), (79, table79)]

theorem certTables_ok : ∀ pt ∈ certTables, pt.1.Prime ∧ pt.2.all (entryOK pt.1) = true := by
  simp only [certTables, List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq]
  exact ⟨⟨by norm_num, table13_ok⟩, ⟨by norm_num, table17_ok⟩, ⟨by norm_num, table19_ok⟩,
    ⟨by norm_num, table23_ok⟩, ⟨by norm_num, table29_ok⟩, ⟨by norm_num, table31_ok⟩,
    ⟨by norm_num, table37_ok⟩, ⟨by norm_num, table41_ok⟩, ⟨by norm_num, table43_ok⟩,
    ⟨by norm_num, table47_ok⟩, ⟨by norm_num, table53_ok⟩, ⟨by norm_num, table59_ok⟩,
    ⟨by norm_num, table61_ok⟩, ⟨by norm_num, table67_ok⟩, ⟨by norm_num, table71_ok⟩,
    ⟨by norm_num, table73_ok⟩, ⟨by norm_num, table79_ok⟩⟩

/-- **The third cuboid polynomial is irreducible whenever the seventeen-prime check succeeds**,
which happens for `≈ 94.8%` of all triples `(a, b, c)` (by residue classes modulo
`13 · 17 · ⋯ · 79`). -/
theorem irreducible_cuboidThreePoly_of_checkB {a b c : ℤ} (h : checkB certTables a b c = true) :
    Irreducible (cuboidThreePoly a b c) :=
  irreducible_of_checkB certTables_ok h

/-- Example: `(a, b, c) = (1, 2, 3)`. -/
theorem irreducible_cuboidThreePoly_one_two_three' : Irreducible (cuboidThreePoly 1 2 3) :=
  irreducible_cuboidThreePoly_of_checkB (by decide +kernel)

/-- Example: `(a, b, c) = (2, 3, 5)`. -/
theorem irreducible_cuboidThreePoly_two_three_five : Irreducible (cuboidThreePoly 2 3 5) :=
  irreducible_cuboidThreePoly_of_checkB (by decide +kernel)

/-- Example: `(a, b, c) = (3, 5, 7)`. -/
theorem irreducible_cuboidThreePoly_three_five_seven : Irreducible (cuboidThreePoly 3 5 7) :=
  irreducible_cuboidThreePoly_of_checkB (by decide +kernel)

end PerfectCuboid.ThirdConjecture.ModP
