theorem compat_13A_17AB : compatB table13A (table17A ++ table17B) = true := by decide +kernel

theorem compat_13B_17AC : compatB table13B (table17A ++ table17C) = true := by decide +kernel

/-- `(a² mod p, b² mod p, c² mod p)`. -/
def sqClass (p : ℕ) (a b c : ℤ) : ℕ × ℕ × ℕ := (sqMod p a, sqMod p b, sqMod p c)

/-- **The third cuboid polynomial is irreducible on explicit classes modulo `13 · 17`.** -/
theorem irreducible_cuboidThreePoly_of_mod_13_17 {a b c : ℤ}
    (h : (sqClass 13 a b c ∈ table13A.map Prod.fst ∧
          sqClass 17 a b c ∈ (table17A ++ table17B).map Prod.fst) ∨
        (sqClass 13 a b c ∈ table13B.map Prod.fst ∧
          sqClass 17 a b c ∈ (table17A ++ table17C).map Prod.fst)) :
    Irreducible (cuboidThreePoly a b c) := by
  have : Fact (Nat.Prime 13) := ⟨by norm_num⟩
  have : Fact (Nat.Prime 17) := ⟨by norm_num⟩
  rcases h with ⟨h13, h17⟩ | ⟨h13, h17⟩
  · exact irreducible_of_tables table13A_ok
      (by rw [List.all_append, table17A_ok, table17B_ok, Bool.and_self]) compat_13A_17AB h13 h17
  · exact irreducible_of_tables table13B_ok
      (by rw [List.all_append, table17A_ok, table17C_ok, Bool.and_self]) compat_13B_17AC h13 h17

/-- Example: `X¹² + 40 X¹⁰ + …` for `(a, b, c) = (1, 2, 3)` is irreducible. -/
theorem irreducible_cuboidThreePoly_one_two_three : Irreducible (cuboidThreePoly 1 2 3) :=
  irreducible_cuboidThreePoly_of_mod_13_17 (by decide +kernel)

end PerfectCuboid.ThirdConjecture.ModP
