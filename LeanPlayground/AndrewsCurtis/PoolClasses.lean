import LeanPlayground.AndrewsCurtis.AK3Class

/-!
# AC-classes among the unsolved SAIR ACC presentations

On 2026-11-07 the public SAIR ACC discovery snapshot listed 2,672 of the 10,115 pool
presentations as unsolved by every team. Breadth-first search in the AC graph restricted
to total relator length ≤ 20, up to signed generator permutations, splits 731 of them into
228 classes of size ≥ 2. Inside each class every presentation is AC-trivial iff the class
representative is, so these 731 open instances are really only 228 distinct problems.

Each certificate lists move ids (`ac-r2-v1`, plus the derived relator swap `14`) taking the
representative to a signed permutation of the member. The kernel replays all of them
(`poolClasses_ok`), and `Cert.triv_iff` turns each into an official `AC.Reachable` statement.
-/

namespace AC.Checker

set_option linter.style.longLine false

/-- An AC-class: representative id and presentation, and certificates for its members. -/
structure PoolClass where
  rep : String
  t : State
  certs : List Cert

/-- Boolean replay of all certificates of a class. -/
def PoolClass.ok (cl : PoolClass) : Bool := cl.certs.all (Cert.ok cl.t)

