theorem poolClasses_ok : poolClasses.all PoolClass.ok = true := by decide +kernel

/-- **Every certified member of a class is AC-trivial iff its representative is.** -/
theorem poolClasses_triv_iff : ∀ cl ∈ poolClasses, ∀ c ∈ cl.certs,
    (Reachable (rel c.s) (standard 2) ↔ Reachable (rel cl.t) (standard 2)) := by
  intro cl hcl c hc
  have h1 := List.all_eq_true.mp poolClasses_ok cl hcl
  exact c.triv_iff cl.t (List.all_eq_true.mp h1 c hc)

set_option maxRecDepth 100000 in
theorem poolClasses_length : poolClasses.length = 228 := by decide +kernel

set_option maxRecDepth 100000 in
theorem poolClasses_members : (poolClasses.map (·.certs.length)).sum = 731 := by decide +kernel

end AC.Checker
