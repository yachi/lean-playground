theorem ak3Certs_ok : ak3Certs.all (Cert.ok AK3) = true := by decide +kernel

/-- **Every presentation in `ak3Certs` is AC-trivial iff `AK(3)` is.** -/
theorem triv_iff_AK3 : ∀ c ∈ ak3Certs,
    (Reachable (rel c.s) (standard 2) ↔ Reachable (rel AK3) (standard 2)) :=
  fun c hc => c.triv_iff AK3 (List.all_eq_true.mp ak3Certs_ok c hc)

theorem ak3Certs_length : ak3Certs.length = 47 := by decide +kernel

end AC.Checker
