import LeanPlayground.AndrewsCurtis.Symmetry

/-!
# Unsolved SAIR ACC presentations in the AC-class of AK(3)

The SAIR ACC Challenge (https://competition.sair.foundation/competitions/acc) pool has
10,115 balanced presentations of the trivial group. On 2026-11-07 the public discovery
snapshot listed 2,672 of them as unsolved by every team. One of them, `ac-00399`, is the
Akbulut–Kirby presentation `AK(3) = ⟨x, y | xyx = yxy, x³ = y⁴⟩` written differently.

We certify that the presentations in `ak3Certs` (all unsolved in the
snapshot) are AC-equivalent to `AK(3)`, up to a signed permutation of the generators.
So each of them is AC-trivial **iff** `AK(3)` is: they are all the same open problem,
and one AC-trivialization of any of them gives AC-trivializations of all of them
(and of `AK(3)`).

Each certificate is a list of official move ids (`ac-r2-v1`) that takes `AK(3)` to a
signed permutation of the pool presentation, found by breadth-first search in the AC
graph restricted to total relator length ≤ 20. The kernel replays all of them.
Relator words are the official ones, encoded as `1 = x`, `-1 = x⁻¹`, `2 = y`, `-2 = y⁻¹`.
-/

namespace AC.Checker

/-- A certificate: a pool presentation `s`, a signed permutation `q`, and moves `ms`
with `run ms t = permS q s` for the class representative `t`. -/
structure Cert where
  id : String
  s : State
  q : SPerm
  ms : List ℕ

/-- Boolean replay of a certificate against the representative `t`. -/
def Cert.ok (t : State) (c : Cert) : Bool := run c.ms t == permS c.q c.s

theorem Cert.triv_iff (t : State) (c : Cert) (h : c.ok t = true) :
    Reachable (rel c.s) (standard 2) ↔ Reachable (rel t) (standard 2) :=
  (triv_iff_of_run_eq_perm t c.s c.ms c.q (by simpa [Cert.ok] using h)).symm

/-- `AK(3) = ⟨x, y | x y x y⁻¹ x⁻¹ y⁻¹, x³ y⁻⁴⟩`. -/
def AK3 : State := ([1, 2, 1, -2, -1, -2], [1, 1, 1, -2, -2, -2, -2])

theorem rel_AK3 :
    rel AK3 = ![FreeGroup.of 0 * FreeGroup.of 1 * FreeGroup.of 0 * (FreeGroup.of 1)⁻¹ *
        (FreeGroup.of 0)⁻¹ * (FreeGroup.of 1)⁻¹,
      FreeGroup.of 0 ^ 3 * (FreeGroup.of 1 ^ 4)⁻¹] := by
  funext k
  fin_cases k <;> simp [rel, AK3, eval, letter, pow_succ, mul_assoc]

