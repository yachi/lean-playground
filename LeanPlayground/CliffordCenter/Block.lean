module

public import Mathlib.Algebra.Algebra.Bilinear
public import Mathlib.Tactic.Module

public section

/-!
# A hyperbolic block `e, f` with `e² = a`, `f² = b`, `ef + fe = 1`

In characteristic 2, a Clifford algebra with a symplectic basis `e₁, …, eₙ, f₁, …, fₙ` is built
from the blocks generated by `eᵢ, fᵢ`. Each block is a quaternion algebra with basis
`1, e, f, ef`. To read off the coordinates of `c₁ + e c_e + f c_f + ef c_g`, where the `c`
commute with `e` and `f`, without knowing that the monomials of the Clifford algebra are linearly
independent, we use the operator

`P x = (ab - 1) x + x ef + b exe - exf + a fxf + ef x - ef x ef`.

It comes from a separability idempotent of the block: `P` maps `1, e, f, ef` to `D, 0, 0, 0` with
`D = 4ab - 1`, and `P (x c) = P x c` when `c` commutes with `e` and `f`. So `P` reads off
`D c₁`, and similar combinations read off the other coordinates: `coord_eq_zero`.
-/

namespace CliffordCenter.Block

-- The block lemmas all take the three relations, so that calls look the same.
set_option linter.unusedSectionVars false

variable {k A : Type*} [Field k] [Ring A] [Algebra k A] {e f : A} {a b : k}

/-- The operator `P` of the module docstring. -/
noncomputable def P (e f : A) (a b : k) : A →ₗ[k] A :=
  (a * b - 1) • LinearMap.id + LinearMap.mulRight k (e * f) +
    b • (LinearMap.mulLeft k e ∘ₗ LinearMap.mulRight k e) -
    LinearMap.mulLeft k e ∘ₗ LinearMap.mulRight k f +
    a • (LinearMap.mulLeft k f ∘ₗ LinearMap.mulRight k f) + LinearMap.mulLeft k (e * f) -
    LinearMap.mulLeft k (e * f) ∘ₗ LinearMap.mulRight k (e * f)

lemma P_apply (x : A) :
    P e f a b x = (a * b - 1) • x + x * (e * f) + b • (e * x * e) - e * x * f +
      a • (f * x * f) + e * f * x - e * f * x * (e * f) := by
  simp [P, mul_assoc]

variable (he : e * e = algebraMap k A a) (hf : f * f = algebraMap k A b)
  (hef : e * f + f * e = 1)
include he hf hef

lemma fe_eq : f * e = 1 - e * f := eq_sub_of_add_eq' hef

/-- Rewriting rules that bring a product of `e` and `f` to a combination of `1, e, f, ef`. -/
lemma e_mul_e (x : A) : e * (e * x) = a • x := by
  rw [← mul_assoc, he, Algebra.smul_def]

lemma f_mul_f (x : A) : f * (f * x) = b • x := by
  rw [← mul_assoc, hf, Algebra.smul_def]

lemma f_mul_e (x : A) : f * (e * x) = x - e * (f * x) := by
  rw [← mul_assoc, fe_eq he hf hef, sub_mul, one_mul, mul_assoc]

lemma e_mul_e' : e * e = a • (1 : A) := by rw [he, Algebra.algebraMap_eq_smul_one]
lemma f_mul_f' : f * f = b • (1 : A) := by rw [hf, Algebra.algebraMap_eq_smul_one]

set_option hygiene false in
/-- Normal form: a combination of `1, e, f, e * f`. -/
macro "block_nf" : tactic => `(tactic| (
  simp only [mul_add, add_mul, mul_sub, sub_mul, mul_smul_comm, smul_mul_assoc, mul_assoc,
    one_mul, mul_one, smul_add, smul_sub, smul_smul,
    e_mul_e he hf hef, f_mul_f he hf hef, f_mul_e he hf hef,
    e_mul_e' he hf hef, f_mul_f' he hf hef, fe_eq he hf hef]))

lemma P_one : P e f a b 1 = (4 * a * b - 1) • (1 : A) := by
  rw [P_apply]
  block_nf
  module

lemma P_e : P e f a b e = 0 := by
  rw [P_apply]; block_nf; module

lemma P_f : P e f a b f = 0 := by
  rw [P_apply]; block_nf; module

lemma P_ef : P e f a b (e * f) = 0 := by
  rw [P_apply]; block_nf; module

omit he hf hef in
/-- `P (x c) = P x c` and `P (c x) = c P x` when `c` commutes with `e` and `f`. -/
lemma P_mul_comm {c : A} (hce : c * e = e * c) (hcf : c * f = f * c) (x : A) :
    P e f a b (x * c) = P e f a b x * c := by
  have hcef : c * (e * f) = e * f * c := by rw [← mul_assoc, hce, mul_assoc, hcf, mul_assoc]
  simp only [P_apply, sub_mul, add_mul, smul_mul_assoc, mul_assoc, hce, hcf, hcef]

/-- The coordinates of `c₁ + e c_e + f c_f + ef c_g` are unique when the `c` commute with `e` and
`f` (and `4ab ≠ 1`). -/
theorem coord_eq_zero (hD : 4 * a * b - 1 ≠ 0) {c₁ cₑ c_f c_g : A}
    (h₁e : c₁ * e = e * c₁) (h₁f : c₁ * f = f * c₁) (hₑe : cₑ * e = e * cₑ)
    (hₑf : cₑ * f = f * cₑ) (h_fe : c_f * e = e * c_f) (h_ff : c_f * f = f * c_f)
    (h_ge : c_g * e = e * c_g) (h_gf : c_g * f = f * c_g)
    (h : c₁ + e * cₑ + f * c_f + e * f * c_g = 0) : c₁ = 0 ∧ cₑ = 0 ∧ c_f = 0 ∧ c_g = 0 := by
  set X := c₁ + e * cₑ + f * c_f + e * f * c_g
  -- `P` applied to `m * c` for each coordinate
  have key : ∀ m₁ mₑ m_f m_g : A,
      P e f a b (m₁ * c₁ + mₑ * cₑ + m_f * c_f + m_g * c_g) =
        P e f a b m₁ * c₁ + P e f a b mₑ * cₑ + P e f a b m_f * c_f + P e f a b m_g * c_g := by
    intro m₁ mₑ m_f m_g
    rw [map_add, map_add, map_add, P_mul_comm h₁e h₁f, P_mul_comm hₑe hₑf, P_mul_comm h_fe h_ff,
      P_mul_comm h_ge h_gf]
  have smul_cancel : ∀ y : A, (4 * a * b - 1) • y = 0 → y = 0 := fun y hy => by
    rw [← inv_smul_smul₀ hD y, hy, smul_zero]
  have hP := P_one he hf hef
  have hPe := P_e he hf hef
  have hPf := P_f he hf hef
  have hPg := P_ef he hf hef
  -- `c₁`: `P X = D c₁`
  have h1 : P e f a b X = (4 * a * b - 1) • c₁ := by
    have : X = 1 * c₁ + e * cₑ + f * c_f + (e * f) * c_g := by simp [X]
    rw [this, key, hP, hPe, hPf, hPg]; simp
  -- `cₑ`: `P (f X) - P (X f) = D cₑ`
  have he' : P e f a b (f * X) - P e f a b (X * f) = (4 * a * b - 1) • cₑ := by
    have h₁ : f * X = f * c₁ + (1 - e * f) * cₑ + (b • 1) * c_f + (f - b • e) * c_g := by
      simp only [X]; block_nf
    have h₂ : X * f = f * c₁ + (e * f) * cₑ + (b • 1) * c_f + (b • e) * c_g := by
      simp only [X, add_mul, mul_assoc, h₁f, hₑf, h_ff, h_gf]; block_nf
    rw [h₁, h₂, key, key]
    simp only [map_sub, map_smul, hP, hPe, hPf, hPg, smul_mul_assoc, one_mul, zero_mul, smul_zero,
      sub_zero, zero_add, add_zero]
    module
  have hf' : P e f a b (X * e) - P e f a b (e * X) = (4 * a * b - 1) • c_f := by
    have h₁ : X * e = e * c₁ + (a • 1) * cₑ + (1 - e * f) * c_f + (e - a • f) * c_g := by
      simp only [X, add_mul, mul_assoc, h₁e, hₑe, h_fe, h_ge]; block_nf
    have h₂ : e * X = e * c₁ + (a • 1) * cₑ + (e * f) * c_f + (a • f) * c_g := by
      simp only [X]; block_nf
    rw [h₁, h₂, key, key]
    simp only [map_sub, map_smul, hP, hPe, hPf, hPg, smul_mul_assoc, one_mul, zero_mul, smul_zero,
      sub_zero, zero_add, add_zero]
    module
  have hg' : P e f a b (f * X * e) + P e f a b (e * X * f) - P e f a b X =
      (4 * a * b - 1) • c_g := by
    have h₁ : f * X * e = (1 - e * f) * c₁ + (a • f) * cₑ + (b • e) * c_f +
        ((1 - a * b) • 1 - e * f) * c_g := by
      simp only [X, add_mul, mul_assoc, h₁e, hₑe, h_fe, h_ge]; block_nf; module
    have h₂ : e * X * f = (e * f) * c₁ + (a • f) * cₑ + (b • e) * c_f + ((a * b) • 1) * c_g := by
      simp only [X, add_mul, mul_assoc, h₁f, hₑf, h_ff, h_gf]; block_nf; module
    rw [h₁, h₂, key, key, h1]
    simp only [map_sub, map_smul, hP, hPe, hPf, hPg, smul_mul_assoc, one_mul, zero_mul,
      smul_zero, sub_zero, zero_add, add_zero]
    module
  rw [h] at h1 he' hf' hg'
  simp only [mul_zero, zero_mul, map_zero, sub_zero, add_zero] at h1 he' hf' hg'
  exact ⟨smul_cancel _ h1.symm, smul_cancel _ he'.symm, smul_cancel _ hf'.symm,
    smul_cancel _ hg'.symm⟩

end CliffordCenter.Block
