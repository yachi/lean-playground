module

public import Mathlib.LinearAlgebra.CliffordAlgebra.Even
public import LeanPlayground.CliffordCenter.Block
public import Mathlib.Tactic.NoncommRing

public section

/-!
# The center of a Clifford algebra in characteristic 2

Chris Peters and Hans Sterk, *On the center of the Clifford Algebra*, arXiv:2610.23323
(2026-10-16), Proposition 1.2. Let `k` be a field of characteristic 2 and `(V, q)` a quadratic
space with a symplectic basis `e₁, …, eₙ, f₁, …, fₙ`: the polar form `b_q` vanishes on pairs of
`e`'s and on pairs of `f`'s, and `b_q(eᵢ, fⱼ) = δᵢⱼ`. Let `z = e₁f₁ + ⋯ + eₙfₙ`. Then

* the centralizer of `C₀(q)` in `C(q)` is `k + k z`: `centralizer_even`;
* b) the center of `C₀(q)` is `k + k z` (`mem_center_even_iff`, and `z ∈ C₀(q)` by `z_mem_even`);
* a) the center of `C(q)` is `k`: `center_eq_bot`;
* c) `z² + z = ∑ q(eᵢ) q(fᵢ)`, the Arf invariant of `q`: `z_mul_z_add_z`.

## The proof

The paper computes commutators of a general `x = ∑ α_{IJ} e_I e_J` with degree 2 elements, degree
by degree. We avoid the monomial basis of `C(q)` (and with it any appeal to linear independence)
and induct on the number of blocks `eᵢ, fᵢ` instead.

Let `A_S` be the subalgebra generated by `eᵢ, fᵢ` for `i ∈ S`. For `s ∉ S`, every element of
`A_{S ∪ {s}}` is `c₁ + e_s c_e + f_s c_f + e_s f_s c_g` with all `c ∈ A_S` (`exists_decomp`), and
the `c` are unique because they commute with `e_s, f_s` (`Block.coord_eq_zero`). If `u` commutes
with the degree 2 elements of `A_{S ∪ {s}}`, so do its coordinates, which by induction lie in
`k + k z_S`. Commuting with `e_s f_s` kills `c_e` and `c_f`. Commuting with `o o'`, where `o`
is `e_s` or `f_s` and `o'` is `e_t` or `f_t` for some `t ∈ S`, forces `u ∈ k + k z_{S ∪ {s}}`.
This is `mem_span_of_commute`.
-/

namespace CliffordCenter.CharTwo

open CliffordAlgebra

variable {k V : Type*} [Field k] [AddCommGroup V] [Module k V] {Q : QuadraticForm k V} {n : ℕ}

/-- `e₁, …, eₙ, f₁, …, fₙ` is a symplectic basis for the polar form of `Q`: it spans `V`, and
`b_q(eᵢ, eⱼ) = b_q(fᵢ, fⱼ) = 0`, `b_q(eᵢ, fⱼ) = δᵢⱼ`. -/
structure IsSymplecticBasis (Q : QuadraticForm k V) (eV fV : Fin n → V) : Prop where
  polar_e : ∀ i j, QuadraticMap.polar Q (eV i) (eV j) = 0
  polar_f : ∀ i j, QuadraticMap.polar Q (fV i) (fV j) = 0
  polar_ef : ∀ i j, QuadraticMap.polar Q (eV i) (fV j) = if i = j then 1 else 0
  span : Submodule.span k (Set.range eV ∪ Set.range fV) = ⊤

variable {eV fV : Fin n → V} (hs : IsSymplecticBasis Q eV fV) (h2 : (2 : k) = 0)

/-- `zᵢ = eᵢ fᵢ`. -/
noncomputable def zi (Q : QuadraticForm k V) (eV fV : Fin n → V) (i : Fin n) :
    CliffordAlgebra Q :=
  ι Q (eV i) * ι Q (fV i)

/-- `z_S = ∑_{i ∈ S} eᵢ fᵢ`. -/
noncomputable def zS (Q : QuadraticForm k V) (eV fV : Fin n → V) (S : Finset (Fin n)) :
    CliffordAlgebra Q :=
  ∑ i ∈ S, zi Q eV fV i

/-- `z = e₁f₁ + ⋯ + eₙfₙ`. -/
noncomputable def z (Q : QuadraticForm k V) (eV fV : Fin n → V) : CliffordAlgebra Q :=
  zS Q eV fV Finset.univ

/-- The generators `eᵢ, fᵢ` for `i ∈ S`. -/
def gens (Q : QuadraticForm k V) (eV fV : Fin n → V) (S : Finset (Fin n)) :
    Set (CliffordAlgebra Q) :=
  {x | ∃ i ∈ S, x = ι Q (eV i) ∨ x = ι Q (fV i)}

/-- The subalgebra `A_S` generated by `eᵢ, fᵢ` for `i ∈ S`. -/
noncomputable def blockAlg (Q : QuadraticForm k V) (eV fV : Fin n → V) (S : Finset (Fin n)) :
    Subalgebra k (CliffordAlgebra Q) :=
  Algebra.adjoin k (gens Q eV fV S)

lemma ι_e_mem {S : Finset (Fin n)} {i : Fin n} (hi : i ∈ S) :
    ι Q (eV i) ∈ blockAlg Q eV fV S :=
  Algebra.subset_adjoin ⟨i, hi, Or.inl rfl⟩

lemma ι_f_mem {S : Finset (Fin n)} {i : Fin n} (hi : i ∈ S) :
    ι Q (fV i) ∈ blockAlg Q eV fV S :=
  Algebra.subset_adjoin ⟨i, hi, Or.inr rfl⟩

/-! ### Relations in characteristic 2 -/

section rel
include h2

lemma neg_eq_self (x : CliffordAlgebra Q) : -x = x := by
  refine neg_eq_of_add_eq_zero_left ?_
  rw [← two_smul k x, h2, zero_smul]

lemma ι_comm_of_polar {x y : V} (h : QuadraticMap.polar Q x y = 0) :
    ι Q x * ι Q y = ι Q y * ι Q x := by
  have := ι_mul_ι_add_swap (Q := Q) x y
  rw [h, map_zero] at this
  rw [eq_neg_of_add_eq_zero_left this, neg_eq_self h2]

include hs

lemma ee_comm (i j : Fin n) : ι Q (eV i) * ι Q (eV j) = ι Q (eV j) * ι Q (eV i) :=
  ι_comm_of_polar h2 (hs.polar_e i j)

lemma ff_comm (i j : Fin n) : ι Q (fV i) * ι Q (fV j) = ι Q (fV j) * ι Q (fV i) :=
  ι_comm_of_polar h2 (hs.polar_f i j)

lemma ef_comm {i j : Fin n} (hij : i ≠ j) :
    ι Q (eV i) * ι Q (fV j) = ι Q (fV j) * ι Q (eV i) :=
  ι_comm_of_polar h2 (by simp [hs.polar_ef, hij])

omit h2 in
lemma ef_add_fe (i : Fin n) : ι Q (eV i) * ι Q (fV i) + ι Q (fV i) * ι Q (eV i) = 1 := by
  simp [ι_mul_ι_add_swap, hs.polar_ef]

/-- Generators from other blocks commute with `eₛ` and `fₛ`. -/
lemma gens_comm {S : Finset (Fin n)} {s : Fin n} (hsS : s ∉ S) {x : CliffordAlgebra Q}
    (hx : x ∈ gens Q eV fV S) : x * ι Q (eV s) = ι Q (eV s) * x ∧
      x * ι Q (fV s) = ι Q (fV s) * x := by
  obtain ⟨i, hi, rfl | rfl⟩ := hx
  · have : i ≠ s := fun h => hsS (h ▸ hi)
    exact ⟨ee_comm hs h2 i s, ef_comm hs h2 this⟩
  · have : s ≠ i := fun h => hsS (h ▸ hi)
    exact ⟨(ef_comm hs h2 this).symm, ff_comm hs h2 i s⟩

/-- `A_S` commutes with `eₛ` and `fₛ` for `s ∉ S`. -/
lemma blockAlg_comm {S : Finset (Fin n)} {s : Fin n} (hsS : s ∉ S) {x : CliffordAlgebra Q}
    (hx : x ∈ blockAlg Q eV fV S) : x * ι Q (eV s) = ι Q (eV s) * x ∧
      x * ι Q (fV s) = ι Q (fV s) * x := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx => exact gens_comm hs h2 hsS hx
  | algebraMap r => exact ⟨Algebra.commutes r _, Algebra.commutes r _⟩
  | add x y _ _ hx hy =>
    exact ⟨by rw [add_mul, mul_add, hx.1, hy.1], by rw [add_mul, mul_add, hx.2, hy.2]⟩
  | mul x y _ _ hx hy =>
    exact ⟨by rw [mul_assoc, hy.1, ← mul_assoc, hx.1, mul_assoc],
      by rw [mul_assoc, hy.2, ← mul_assoc, hx.2, mul_assoc]⟩

/-- Every element of `A_{S ∪ {s}}` is `c₁ + eₛ c_e + fₛ c_f + eₛ fₛ c_g` with all `c ∈ A_S`. -/
theorem exists_decomp {S : Finset (Fin n)} {s : Fin n} (hsS : s ∉ S) {u : CliffordAlgebra Q}
    (hu : u ∈ blockAlg Q eV fV (insert s S)) :
    ∃ c₁ ∈ blockAlg Q eV fV S, ∃ cₑ ∈ blockAlg Q eV fV S, ∃ c_f ∈ blockAlg Q eV fV S,
      ∃ c_g ∈ blockAlg Q eV fV S,
        u = c₁ + ι Q (eV s) * cₑ + ι Q (fV s) * c_f + ι Q (eV s) * ι Q (fV s) * c_g := by
  set B := blockAlg Q eV fV S
  generalize hE : ι Q (eV s) = E
  generalize hF : ι Q (fV s) = F
  let W : Set (CliffordAlgebra Q) := {w | ∃ c₁ ∈ B, ∃ cₑ ∈ B, ∃ c_f ∈ B, ∃ c_g ∈ B,
    w = c₁ + E * cₑ + F * c_f + E * F * c_g}
  have he : E * E = algebraMap k _ (Q (eV s)) := hE ▸ ι_sq_scalar Q _
  have hf : F * F = algebraMap k _ (Q (fV s)) := hF ▸ ι_sq_scalar Q _
  have hef : E * F + F * E = 1 := hE ▸ hF ▸ ef_add_fe hs s
  have hfe : F * E = 1 - E * F := Block.fe_eq he hf hef
  -- `W` is closed under left multiplication by every element of `A_{S ∪ {s}}`
  have key : ∀ x ∈ blockAlg Q eV fV (insert s S), ∀ w ∈ W, x * w ∈ W := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rintro w ⟨c₁, h₁, cₑ, hₑ, c_f, h_f, c_g, h_g, rfl⟩
      obtain ⟨i, hi, rfl | rfl⟩ := hx
      · rcases Finset.mem_insert.1 hi with rfl | hi
        · refine ⟨Q (eV i) • cₑ, B.smul_mem hₑ _, c₁, h₁, Q (eV i) • c_g, B.smul_mem h_g _, c_f,
            h_f, ?_⟩
          rw [hE]
          simp only [mul_add, mul_assoc, Block.e_mul_e he hf hef, mul_smul_comm]
          abel
        · obtain ⟨hcE, hcF⟩ := gens_comm hs h2 hsS ⟨i, hi, Or.inl rfl⟩
          rw [hE] at hcE
          rw [hF] at hcF
          refine ⟨_, B.mul_mem (ι_e_mem hi) h₁, _, B.mul_mem (ι_e_mem hi) hₑ, _,
            B.mul_mem (ι_e_mem hi) h_f, _, B.mul_mem (ι_e_mem hi) h_g, ?_⟩
          have hcE' : ∀ y, ι Q (eV i) * (E * y) = E * (ι Q (eV i) * y) :=
            fun y => by rw [← mul_assoc, hcE, mul_assoc]
          have hcF' : ∀ y, ι Q (eV i) * (F * y) = F * (ι Q (eV i) * y) :=
            fun y => by rw [← mul_assoc, hcF, mul_assoc]
          simp only [mul_add, mul_assoc, hcE', hcF']
      · rcases Finset.mem_insert.1 hi with rfl | hi
        · refine ⟨cₑ + Q (fV i) • c_f, B.add_mem hₑ (B.smul_mem h_f _), -(Q (fV i) • c_g),
            B.neg_mem (B.smul_mem h_g _), c₁ + c_g, B.add_mem h₁ h_g, -cₑ, B.neg_mem hₑ, ?_⟩
          rw [hF]
          simp only [mul_add, mul_assoc, Block.f_mul_f he hf hef, Block.f_mul_e he hf hef,
            mul_smul_comm, mul_neg]
          module
        · obtain ⟨hcE, hcF⟩ := gens_comm hs h2 hsS ⟨i, hi, Or.inr rfl⟩
          rw [hE] at hcE
          rw [hF] at hcF
          refine ⟨_, B.mul_mem (ι_f_mem hi) h₁, _, B.mul_mem (ι_f_mem hi) hₑ, _,
            B.mul_mem (ι_f_mem hi) h_f, _, B.mul_mem (ι_f_mem hi) h_g, ?_⟩
          have hcE' : ∀ y, ι Q (fV i) * (E * y) = E * (ι Q (fV i) * y) :=
            fun y => by rw [← mul_assoc, hcE, mul_assoc]
          have hcF' : ∀ y, ι Q (fV i) * (F * y) = F * (ι Q (fV i) * y) :=
            fun y => by rw [← mul_assoc, hcF, mul_assoc]
          simp only [mul_add, mul_assoc, hcE', hcF']
    | algebraMap r =>
      rintro w ⟨c₁, h₁, cₑ, hₑ, c_f, h_f, c_g, h_g, rfl⟩
      refine ⟨r • c₁, B.smul_mem h₁ r, r • cₑ, B.smul_mem hₑ r, r • c_f, B.smul_mem h_f r,
        r • c_g, B.smul_mem h_g r, ?_⟩
      simp only [← Algebra.smul_def, smul_add, mul_smul_comm]
    | add x y _ _ hx hy =>
      intro w hw
      obtain ⟨a₁, ha₁, aₑ, haₑ, a_f, ha_f, a_g, ha_g, hxw⟩ := hx w hw
      obtain ⟨b₁, hb₁, bₑ, hbₑ, b_f, hb_f, b_g, hb_g, hyw⟩ := hy w hw
      refine ⟨a₁ + b₁, B.add_mem ha₁ hb₁, aₑ + bₑ, B.add_mem haₑ hbₑ, a_f + b_f,
        B.add_mem ha_f hb_f, a_g + b_g, B.add_mem ha_g hb_g, ?_⟩
      rw [add_mul, hxw, hyw]
      noncomm_ring
    | mul x y _ _ hx hy => intro w hw; rw [mul_assoc]; exact hx _ (hy w hw)
  have h1 : (1 : CliffordAlgebra Q) ∈ W := ⟨1, B.one_mem, 0, B.zero_mem, 0, B.zero_mem, 0,
    B.zero_mem, by simp⟩
  have := key u hu 1 h1
  rw [mul_one] at this
  subst hE hF
  exact this

omit hs in
lemma add_self (x : CliffordAlgebra Q) : x + x = 0 := by
  rw [← two_smul k x, h2, zero_smul]

/-- The coordinates in `exists_decomp` are unique. -/
theorem coord_eq_zero {S : Finset (Fin n)} {s : Fin n} (hsS : s ∉ S)
    {c₁ cₑ c_f c_g : CliffordAlgebra Q} (h₁ : c₁ ∈ blockAlg Q eV fV S)
    (hₑ : cₑ ∈ blockAlg Q eV fV S) (h_f : c_f ∈ blockAlg Q eV fV S)
    (h_g : c_g ∈ blockAlg Q eV fV S)
    (h : c₁ + ι Q (eV s) * cₑ + ι Q (fV s) * c_f + ι Q (eV s) * ι Q (fV s) * c_g = 0) :
    c₁ = 0 ∧ cₑ = 0 ∧ c_f = 0 ∧ c_g = 0 := by
  have hD : 4 * Q (eV s) * Q (fV s) - 1 ≠ 0 := by
    rw [show (4 : k) = 2 * 2 by norm_num, h2]; simp
  have hc := fun {c} (hc : c ∈ blockAlg Q eV fV S) => blockAlg_comm hs h2 hsS hc
  exact Block.coord_eq_zero (ι_sq_scalar Q _) (ι_sq_scalar Q _) (ef_add_fe hs s) hD (hc h₁).1
    (hc h₁).2 (hc hₑ).1 (hc hₑ).2 (hc h_f).1 (hc h_f).2 (hc h_g).1 (hc h_g).2 h

/-- If `w ∈ A_S` commutes with `u`, it commutes with the coordinates of `u`. -/
theorem comm_coord {S : Finset (Fin n)} {s : Fin n} (hsS : s ∉ S)
    {c₁ cₑ c_f c_g w : CliffordAlgebra Q} (h₁ : c₁ ∈ blockAlg Q eV fV S)
    (hₑ : cₑ ∈ blockAlg Q eV fV S) (h_f : c_f ∈ blockAlg Q eV fV S)
    (h_g : c_g ∈ blockAlg Q eV fV S) (hw : w ∈ blockAlg Q eV fV S)
    (h : w * (c₁ + ι Q (eV s) * cₑ + ι Q (fV s) * c_f + ι Q (eV s) * ι Q (fV s) * c_g) =
      (c₁ + ι Q (eV s) * cₑ + ι Q (fV s) * c_f + ι Q (eV s) * ι Q (fV s) * c_g) * w) :
    w * c₁ = c₁ * w ∧ w * cₑ = cₑ * w ∧ w * c_f = c_f * w ∧ w * c_g = c_g * w := by
  set B := blockAlg Q eV fV S
  obtain ⟨hwE, hwF⟩ := blockAlg_comm hs h2 hsS hw
  have hE : ∀ y, w * (ι Q (eV s) * y) = ι Q (eV s) * (w * y) := fun y => by
    rw [← mul_assoc, hwE, mul_assoc]
  have hF : ∀ y, w * (ι Q (fV s) * y) = ι Q (fV s) * (w * y) := fun y => by
    rw [← mul_assoc, hwF, mul_assoc]
  have key : (w * c₁ - c₁ * w) + ι Q (eV s) * (w * cₑ - cₑ * w) +
      ι Q (fV s) * (w * c_f - c_f * w) + ι Q (eV s) * ι Q (fV s) * (w * c_g - c_g * w) = 0 := by
    rw [← sub_eq_zero] at h
    rw [← h]
    simp only [mul_add, add_mul, mul_sub, mul_assoc, hE, hF]
    abel
  obtain ⟨k₁, kₑ, k_f, k_g⟩ := coord_eq_zero hs h2 hsS (B.sub_mem (B.mul_mem hw h₁)
    (B.mul_mem h₁ hw)) (B.sub_mem (B.mul_mem hw hₑ) (B.mul_mem hₑ hw))
    (B.sub_mem (B.mul_mem hw h_f) (B.mul_mem h_f hw))
    (B.sub_mem (B.mul_mem hw h_g) (B.mul_mem h_g hw)) key
  exact ⟨sub_eq_zero.1 k₁, sub_eq_zero.1 kₑ, sub_eq_zero.1 k_f, sub_eq_zero.1 k_g⟩

lemma zi_mul_e (s : Fin n) :
    zi Q eV fV s * ι Q (eV s) = ι Q (eV s) * zi Q eV fV s + ι Q (eV s) := by
  have he := ι_sq_scalar Q (eV s)
  have hf := ι_sq_scalar Q (fV s)
  have hef := ef_add_fe hs s
  simp only [zi, mul_assoc, Block.fe_eq he hf hef, mul_sub, mul_one, Block.e_mul_e he hf hef]
  rw [sub_eq_add_neg, neg_eq_self h2, add_comm]

lemma zi_mul_f (s : Fin n) :
    zi Q eV fV s * ι Q (fV s) = ι Q (fV s) * zi Q eV fV s + ι Q (fV s) := by
  have he := ι_sq_scalar Q (eV s)
  have hf := ι_sq_scalar Q (fV s)
  have hef := ef_add_fe hs s
  simp only [zi, mul_assoc, Block.f_mul_f' he hf hef, ← mul_assoc _ (ι Q (eV s)),
    Block.fe_eq he hf hef, sub_mul, one_mul, mul_smul_comm, mul_one]
  rw [sub_eq_add_neg, neg_eq_self h2]
  nth_rewrite 1 [← zero_add (Q (fV s) • ι Q (eV s)), ← add_self h2 (ι Q (fV s))]
  abel

lemma zi_mul_block {s : Fin n} {o : CliffordAlgebra Q}
    (ho : o ∈ ({ι Q (eV s), ι Q (fV s)} : Set _)) : zi Q eV fV s * o = o * zi Q eV fV s + o := by
  rcases ho with rfl | rfl
  · exact zi_mul_e hs h2 s
  · exact zi_mul_f hs h2 s

omit hs h2 in
lemma zi_mem {S : Finset (Fin n)} {i : Fin n} (hi : i ∈ S) : zi Q eV fV i ∈ blockAlg Q eV fV S :=
  mul_mem (ι_e_mem hi) (ι_f_mem hi)

omit hs h2 in
lemma zS_mem (S : Finset (Fin n)) : zS Q eV fV S ∈ blockAlg Q eV fV S :=
  Subalgebra.sum_mem _ fun _ hi => zi_mem hi

/-- `z_S` acts on `eₜ, fₜ` (`t ∈ S`) like `zₜ`. -/
lemma zS_mul_block {S : Finset (Fin n)} {t : Fin n} (ht : t ∈ S) {o : CliffordAlgebra Q}
    (ho : o ∈ ({ι Q (eV t), ι Q (fV t)} : Set _)) :
    zS Q eV fV S * o = o * zS Q eV fV S + o := by
  have hcomm : ∀ i ∈ S.erase t, zi Q eV fV i * o = o * zi Q eV fV i := by
    intro i hi
    have hit : i ≠ t := Finset.ne_of_mem_erase hi
    have hz : zi Q eV fV i * ι Q (eV t) = ι Q (eV t) * zi Q eV fV i ∧
        zi Q eV fV i * ι Q (fV t) = ι Q (fV t) * zi Q eV fV i :=
      blockAlg_comm hs h2 (S := {i}) (by simpa using hit.symm)
        (zi_mem (Finset.mem_singleton_self i))
    rcases ho with rfl | rfl
    · exact hz.1
    · exact hz.2
  rw [zS, ← Finset.add_sum_erase _ _ ht, add_mul, mul_add, zi_mul_block hs h2 ho,
    Finset.sum_mul, Finset.mul_sum, Finset.sum_congr rfl hcomm]
  abel

omit hs h2 in
/-- If `[Z, w] = w` and `[z', w] = w`, then `[u, w] = w Δ` for `u = α + β z' + Z (γ + δ z')`. -/
lemma comm_formula {Z z' w : CliffordAlgebra Q} (hZ : Z * w = w * Z + w) (hz : z' * w = w * z' + w)
    (α β γ δ : k) :
    (α • 1 + β • z' + Z * (γ • 1 + δ • z')) * w - w * (α • 1 + β • z' + Z * (γ • 1 + δ • z')) =
      w * ((β + γ + δ) • 1 + δ • z' + Z * (δ • 1)) := by
  have hZ' : ∀ x, Z * (w * x) = w * (Z * x) + w * x := fun x => by
    rw [← mul_assoc, hZ, add_mul, mul_assoc]
  have hz' : ∀ x, z' * (w * x) = w * (z' * x) + w * x := fun x => by
    rw [← mul_assoc, hz, add_mul, mul_assoc]
  simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, one_mul, mul_one, mul_assoc, hZ',
    hz, hZ, add_smul, smul_add]
  abel

omit h2 in
/-- If `o o' Δ = 0` for all `o ∈ {eₛ, fₛ}`, `o' ∈ {eₜ, fₜ}`, then `Δ = 0`. -/
lemma eq_zero_of_block_mul {s t : Fin n} {Δ : CliffordAlgebra Q}
    (h : ∀ o ∈ ({ι Q (eV s), ι Q (fV s)} : Set _), ∀ o' ∈ ({ι Q (eV t), ι Q (fV t)} : Set _),
      o * o' * Δ = 0) : Δ = 0 := by
  have h' : ∀ o' ∈ ({ι Q (eV t), ι Q (fV t)} : Set _), o' * Δ = 0 := by
    intro o' ho'
    calc o' * Δ = (ι Q (eV s) * ι Q (fV s) + ι Q (fV s) * ι Q (eV s)) * (o' * Δ) := by
          rw [ef_add_fe hs s, one_mul]
      _ = ι Q (eV s) * (ι Q (fV s) * o' * Δ) + ι Q (fV s) * (ι Q (eV s) * o' * Δ) := by
          noncomm_ring
      _ = 0 := by rw [h _ (Or.inr rfl) _ ho', h _ (Or.inl rfl) _ ho', mul_zero, mul_zero, add_zero]
  calc Δ = (ι Q (eV t) * ι Q (fV t) + ι Q (fV t) * ι Q (eV t)) * Δ := by
        rw [ef_add_fe hs t, one_mul]
    _ = ι Q (eV t) * (ι Q (fV t) * Δ) + ι Q (fV t) * (ι Q (eV t) * Δ) := by noncomm_ring
    _ = 0 := by rw [h' _ (Or.inr rfl), h' _ (Or.inl rfl), mul_zero, mul_zero, add_zero]

end rel

/-! ### The induction on blocks -/

omit hs h2 in
lemma blockAlg_empty : blockAlg Q eV fV ∅ = ⊥ := by
  rw [blockAlg, show gens Q eV fV ∅ = ∅ by ext; simp [gens], Algebra.adjoin_empty]

include hs h2

/-- An element of `A_S` commuting with the degree 2 elements of `A_S` is in `k + k z_S`. -/
theorem mem_span_of_commute (S : Finset (Fin n)) {u : CliffordAlgebra Q}
    (hu : u ∈ blockAlg Q eV fV S) (hz : ∀ i ∈ S, zi Q eV fV i * u = u * zi Q eV fV i)
    (ho : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → ∀ o ∈ ({ι Q (eV i), ι Q (fV i)} : Set _),
      ∀ o' ∈ ({ι Q (eV j), ι Q (fV j)} : Set _), o * o' * u = u * (o * o')) :
    u ∈ Submodule.span k {1, zS Q eV fV S} := by
  induction S using Finset.induction_on generalizing u with
  | empty =>
    rw [blockAlg_empty, Algebra.mem_bot] at hu
    obtain ⟨r, rfl⟩ := hu
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_insert _ _))
  | insert s S hsS ih =>
    rcases subsingleton_or_nontrivial (CliffordAlgebra Q) with hsub | hnt
    · rw [Subsingleton.elim u 0]; exact Submodule.zero_mem _
    set B := blockAlg Q eV fV S
    obtain ⟨c₁, h₁, cₑ, hₑ, c_f, h_f, c_g, h_g, rfl⟩ := exists_decomp hs h2 hsS hu
    have hmem : ∀ i ∈ S, i ∈ insert s S := fun i hi => Finset.mem_insert_of_mem hi
    -- the coordinates satisfy the hypotheses for `S`, so they lie in `k + k z_S`
    have hc : ∀ w ∈ B, w * (c₁ + ι Q (eV s) * cₑ + ι Q (fV s) * c_f +
        ι Q (eV s) * ι Q (fV s) * c_g) = (c₁ + ι Q (eV s) * cₑ + ι Q (fV s) * c_f +
          ι Q (eV s) * ι Q (fV s) * c_g) * w →
        w * c₁ = c₁ * w ∧ w * cₑ = cₑ * w ∧ w * c_f = c_f * w ∧ w * c_g = c_g * w :=
      fun w hw h => comm_coord hs h2 hsS h₁ hₑ h_f h_g hw h
    have hpair : ∀ i ∈ S, ∀ j ∈ S, ∀ o ∈ ({ι Q (eV i), ι Q (fV i)} : Set _),
        ∀ o' ∈ ({ι Q (eV j), ι Q (fV j)} : Set _), o * o' ∈ B := by
      rintro i hi j hj o (rfl | rfl) o' (rfl | rfl) <;>
        exact mul_mem (by first | exact ι_e_mem hi | exact ι_f_mem hi)
          (by first | exact ι_e_mem hj | exact ι_f_mem hj)
    have hcoord : ∀ c ∈ B, (∀ w ∈ B, (w * (c₁ + ι Q (eV s) * cₑ + ι Q (fV s) * c_f +
        ι Q (eV s) * ι Q (fV s) * c_g) = (c₁ + ι Q (eV s) * cₑ + ι Q (fV s) * c_f +
          ι Q (eV s) * ι Q (fV s) * c_g) * w) → w * c = c * w) →
        c ∈ Submodule.span k {1, zS Q eV fV S} := fun c hcB hcw =>
      ih hcB (fun i hi => hcw _ (zi_mem hi) (hz i (hmem i hi)))
        (fun i hi j hj hij o hoi o' hoj => hcw _ (hpair i hi j hj o hoi o' hoj)
          (ho i (hmem i hi) j (hmem j hj) hij o hoi o' hoj))
    have hc₁ := hcoord c₁ h₁ fun w hw h => (hc w hw h).1
    have hc_g := hcoord c_g h_g fun w hw h => (hc w hw h).2.2.2
    -- commuting with `zₛ = eₛ fₛ` kills `cₑ` and `c_f`
    have hcZ : ∀ c ∈ B, c * zi Q eV fV s = zi Q eV fV s * c := fun c hcB => by
      obtain ⟨hE, hF⟩ := blockAlg_comm hs h2 hsS hcB
      rw [zi, ← mul_assoc, hE, mul_assoc, hF, mul_assoc]
    have hZE : ∀ x, zi Q eV fV s * (ι Q (eV s) * x) =
        ι Q (eV s) * (zi Q eV fV s * x) + ι Q (eV s) * x := fun x => by
      rw [← mul_assoc, zi_mul_e hs h2, add_mul, mul_assoc]
    have hZF : ∀ x, zi Q eV fV s * (ι Q (fV s) * x) =
        ι Q (fV s) * (zi Q eV fV s * x) + ι Q (fV s) * x := fun x => by
      rw [← mul_assoc, zi_mul_f hs h2, add_mul, mul_assoc]
    have hzi : ι Q (eV s) * ι Q (fV s) = zi Q eV fV s := rfl
    have key : 0 + ι Q (eV s) * cₑ + ι Q (fV s) * c_f + ι Q (eV s) * ι Q (fV s) * 0 = 0 := by
      refine Eq.trans ?_ (sub_eq_zero.2 (hz s (Finset.mem_insert_self s S)))
      rw [hzi]
      simp only [mul_add, add_mul, mul_assoc, hcZ c₁ h₁, hcZ cₑ hₑ, hcZ c_f h_f, hcZ c_g h_g,
        hZE, hZF, mul_zero, add_zero]
      abel
    obtain ⟨-, rfl, rfl, -⟩ := coord_eq_zero hs h2 hsS B.zero_mem hₑ h_f B.zero_mem key
    obtain ⟨α, β, rfl⟩ := Submodule.mem_span_pair.1 hc₁
    obtain ⟨γ, δ, rfl⟩ := Submodule.mem_span_pair.1 hc_g
    simp only [mul_zero, add_zero, hzi] at ho ⊢
    rw [zS, Finset.sum_insert hsS, ← zS]
    rcases S.eq_empty_or_nonempty with rfl | ⟨t, ht⟩
    · refine Submodule.mem_span_pair.2 ⟨α, γ, ?_⟩
      simp [zS]
    have hst : s ≠ t := fun h => hsS (h ▸ ht)
    -- commuting with `o o'` forces `δ = 0` and `γ = β`
    have hΔ : ∀ o ∈ ({ι Q (eV s), ι Q (fV s)} : Set _), ∀ o' ∈ ({ι Q (eV t), ι Q (fV t)} : Set _),
        o * o' * ((β + γ + δ) • 1 + δ • zS Q eV fV S + zi Q eV fV s * (δ • 1)) = 0 := by
      intro o hos o' hot
      have hZo' : zi Q eV fV s * o' = o' * zi Q eV fV s := by
        have := blockAlg_comm hs h2 (S := {s}) (s := t) (by simpa using hst.symm)
          (zi_mem (Finset.mem_singleton_self s))
        rcases hot with rfl | rfl
        · exact this.1
        · exact this.2
      have hzo : zS Q eV fV S * o = o * zS Q eV fV S := by
        have := blockAlg_comm hs h2 hsS (zS_mem S)
        rcases hos with rfl | rfl
        · exact this.1
        · exact this.2
      have hZw : zi Q eV fV s * (o * o') = o * o' * zi Q eV fV s + o * o' := by
        rw [← mul_assoc, zi_mul_block hs h2 hos, add_mul, mul_assoc, hZo', ← mul_assoc]
      have hzw : zS Q eV fV S * (o * o') = o * o' * zS Q eV fV S + o * o' := by
        rw [← mul_assoc, hzo, mul_assoc, zS_mul_block hs h2 ht hot, mul_add, ← mul_assoc]
      rw [← comm_formula hZw hzw α β γ δ, sub_eq_zero]
      exact (ho s (Finset.mem_insert_self s S) t (Finset.mem_insert_of_mem ht) hst o hos o'
        hot).symm
    have hΔ0 := eq_zero_of_block_mul hs hΔ
    have hsmul : ∀ r : k, r • (1 : CliffordAlgebra Q) = 0 → r = 0 := fun r hr => by
      by_contra h
      exact one_ne_zero (by rw [← inv_smul_smul₀ h (1 : CliffordAlgebra Q), hr, smul_zero])
    have hΔ' : ((β + γ + δ) • 1 + δ • zS Q eV fV S) + ι Q (eV s) * 0 + ι Q (fV s) * 0 +
        ι Q (eV s) * ι Q (fV s) * (δ • 1) = 0 := by
      refine Eq.trans ?_ hΔ0
      rw [hzi]; simp
    obtain ⟨hc1, -, -, hcg⟩ := coord_eq_zero hs h2 hsS
      (B.add_mem (B.smul_mem B.one_mem _) (B.smul_mem (zS_mem S) _)) B.zero_mem B.zero_mem
      (B.smul_mem B.one_mem _) hΔ'
    obtain rfl := hsmul δ hcg
    simp only [add_zero, zero_smul] at hc1
    have hγ : γ = β := by
      have h := hsmul _ hc1
      have hββ : β + β = 0 := by rw [← two_mul, h2, zero_mul]
      calc γ = (β + γ) + β := by rw [add_comm β γ, add_assoc, hββ, add_zero]
        _ = β := by rw [h, zero_add]
    subst hγ
    refine Submodule.mem_span_pair.2 ⟨α, γ, ?_⟩
    simp only [zero_smul, add_zero, mul_smul_comm, mul_one, smul_add]
    abel

/-! ### Proposition 1.2 -/

omit h2 in
lemma blockAlg_univ : blockAlg Q eV fV Finset.univ = ⊤ := by
  refine eq_top_iff.2 ?_
  rw [← adjoin_range_ι, Algebra.adjoin_le_iff]
  rintro _ ⟨m, rfl⟩
  have hm : m ∈ Submodule.span k (Set.range eV ∪ Set.range fV) := hs.span ▸ Submodule.mem_top
  induction hm using Submodule.span_induction with
  | mem x hx =>
    rcases hx with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · exact ι_e_mem (Finset.mem_univ i)
    · exact ι_f_mem (Finset.mem_univ i)
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul r x _ hx => rw [map_smul]; exact Subalgebra.smul_mem _ hx r

omit hs h2 in
lemma ι_mul_ι_mem_even (m₁ m₂ : V) : ι Q m₁ * ι Q m₂ ∈ even Q := by
  rw [← Subalgebra.mem_toSubmodule, even_toSubmodule]
  exact ι_mul_ι_mem_evenOdd_zero Q _ _

omit hs h2 in
/-- `z ∈ C₀(q)`. -/
theorem z_mem_even : z Q eV fV ∈ even Q := by
  simp only [z, zS, zi]
  exact Subalgebra.sum_mem _ fun i _ => ι_mul_ι_mem_even _ _

/-- `z ι(m) = ι(m) z + ι(m)` for every `m ∈ V`. -/
lemma z_mul_ι (m : V) : z Q eV fV * ι Q m = ι Q m * z Q eV fV + ι Q m := by
  have hm : m ∈ Submodule.span k (Set.range eV ∪ Set.range fV) := hs.span ▸ Submodule.mem_top
  induction hm using Submodule.span_induction with
  | mem x hx =>
    rcases hx with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · exact zS_mul_block hs h2 (Finset.mem_univ i) (Or.inl rfl)
    · exact zS_mul_block hs h2 (Finset.mem_univ i) (Or.inr rfl)
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, mul_add, add_mul, hx, hy]; abel
  | smul r x _ hx => rw [map_smul, mul_smul_comm, smul_mul_assoc, hx, smul_add]

/-- `z` commutes with `C₀(q)`. -/
lemma z_comm_of_mem_even {x : CliffordAlgebra Q} (hx : x ∈ evenOdd Q 0) :
    z Q eV fV * x = x * z Q eV fV := by
  induction x, hx using even_induction with
  | algebraMap r => exact (Algebra.commutes r _).symm
  | add x y _ _ hx hy => rw [mul_add, add_mul, hx, hy]
  | ι_mul_ι_mul m₁ m₂ x _ hx =>
    rw [← mul_assoc, ← mul_assoc, z_mul_ι hs h2, add_mul, mul_assoc, z_mul_ι hs h2, mul_add,
      add_mul, add_mul, mul_assoc, mul_assoc, mul_assoc, hx, ← mul_assoc (ι Q m₁), add_assoc,
      add_self h2, add_zero]
    simp only [mul_assoc]

/-- The centralizer of `C₀(q)` in `C(q)` is `k + k z`. -/
theorem centralizer_even :
    Subalgebra.toSubmodule (Subalgebra.centralizer k (even Q : Set (CliffordAlgebra Q))) =
      Submodule.span k {1, z Q eV fV} := by
  ext u
  rw [Subalgebra.mem_toSubmodule, Subalgebra.mem_centralizer_iff]
  constructor
  · intro h
    refine mem_span_of_commute hs h2 Finset.univ (blockAlg_univ hs ▸ Algebra.mem_top)
      (fun i _ => h _ (ι_mul_ι_mem_even _ _)) ?_
    rintro i - j - - o (rfl | rfl) o' (rfl | rfl) <;> exact h _ (ι_mul_ι_mem_even _ _)
  · intro h g hg
    have hg' : g ∈ evenOdd Q 0 := by rwa [← even_toSubmodule]
    obtain ⟨c, d, rfl⟩ := Submodule.mem_span_pair.1 h
    simp only [mul_add, add_mul, mul_smul_comm, smul_mul_assoc, mul_one, one_mul,
      z_comm_of_mem_even hs h2 hg']

/-- Proposition 1.2 a): the center of `C(q)` is `k`. -/
theorem center_eq_bot : Subalgebra.center k (CliffordAlgebra Q) = ⊥ := by
  refine eq_bot_iff.2 fun x hx => ?_
  rcases subsingleton_or_nontrivial (CliffordAlgebra Q) with hsub | hnt
  · exact Algebra.mem_bot.2 ⟨0, Subsingleton.elim _ _⟩
  rw [Subalgebra.mem_center_iff] at hx
  have hx' : x ∈ Subalgebra.toSubmodule (Subalgebra.centralizer k (even Q : Set _)) :=
    (Subalgebra.mem_centralizer_iff k).2 fun g _ => hx g
  rw [centralizer_even hs h2] at hx'
  obtain ⟨c, d, rfl⟩ := Submodule.mem_span_pair.1 hx'
  suffices hd : d • z Q eV fV = 0 by
    rw [hd, add_zero]
    exact Algebra.mem_bot.2 ⟨c, Algebra.algebraMap_eq_smul_one c⟩
  rcases Nat.eq_zero_or_pos n with rfl | hpos
  · simp [z, zS]
  have h := hx (ι Q (eV ⟨0, hpos⟩))
  rw [mul_add, add_mul, mul_smul_comm, mul_smul_comm, smul_mul_assoc, smul_mul_assoc, mul_one,
    one_mul, z_mul_ι hs h2, smul_add, ← add_assoc] at h
  have hdE : d • ι Q (eV ⟨0, hpos⟩) = 0 := by simpa using h
  by_cases hd : d = 0
  · rw [hd, zero_smul]
  have hE : ι Q (eV ⟨0, hpos⟩) = 0 := by rw [← inv_smul_smul₀ hd (ι Q _), hdE, smul_zero]
  have := ef_add_fe hs (⟨0, hpos⟩ : Fin n)
  rw [hE, zero_mul, mul_zero, add_zero] at this
  exact absurd this.symm one_ne_zero

omit h2 in
/-- `C₀(q)`-membership is a statement about the elements of `C(q)`. -/
lemma mem_span_of_mem_center_even (h2 : (2 : k) = 0) {x : even Q}
    (hx : x ∈ Subalgebra.center k (even Q)) :
    (x : CliffordAlgebra Q) ∈ Submodule.span k {1, z Q eV fV} := by
  rw [← centralizer_even hs h2, Subalgebra.mem_toSubmodule, Subalgebra.mem_centralizer_iff]
  intro g hg
  exact congrArg Subtype.val (Subalgebra.mem_center_iff.1 hx ⟨g, hg⟩)

/-- Proposition 1.2 b): the center of `C₀(q)` is `k + k z` (and `z ∈ C₀(q)` by `z_mem_even`). -/
theorem mem_center_even_iff (x : even Q) :
    x ∈ Subalgebra.center k (even Q) ↔
      (x : CliffordAlgebra Q) ∈ Submodule.span k {1, z Q eV fV} := by
  refine ⟨mem_span_of_mem_center_even hs h2, fun h => ?_⟩
  rw [← centralizer_even hs h2, Subalgebra.mem_toSubmodule,
    Subalgebra.mem_centralizer_iff] at h
  exact Subalgebra.mem_center_iff.2 fun g => Subtype.ext (h g g.2)

/-- `zᵢ² + zᵢ = q(eᵢ) q(fᵢ)`. -/
lemma zi_mul_zi_add_zi (i : Fin n) :
    zi Q eV fV i * zi Q eV fV i + zi Q eV fV i = algebraMap k _ (Q (eV i) * Q (fV i)) := by
  have he := ι_sq_scalar Q (eV i)
  have hf := ι_sq_scalar Q (fV i)
  have hef := ef_add_fe hs i
  simp only [zi, mul_assoc, Block.f_mul_e he hf hef, mul_sub, Block.e_mul_e' he hf hef,
    mul_smul_comm, Block.f_mul_f' he hf hef, smul_smul, mul_one]
  rw [sub_eq_add_neg, neg_eq_self h2,
    show ∀ x y : CliffordAlgebra Q, x + y + x = y + (x + x) from fun x y => by abel,
    add_self h2, add_zero, mul_comm, Algebra.algebraMap_eq_smul_one]

/-- Proposition 1.2 c): `z² + z = ∑ q(eᵢ) q(fᵢ)`, the Arf invariant of `q`. -/
theorem z_mul_z_add_z :
    z Q eV fV * z Q eV fV + z Q eV fV = algebraMap k _ (∑ i, Q (eV i) * Q (fV i)) := by
  suffices ∀ S : Finset (Fin n), zS Q eV fV S * zS Q eV fV S + zS Q eV fV S =
      algebraMap k _ (∑ i ∈ S, Q (eV i) * Q (fV i)) from this Finset.univ
  intro S
  induction S using Finset.induction_on with
  | empty => simp [zS]
  | insert s S hsS ih =>
    have hcomm : zS Q eV fV S * zi Q eV fV s = zi Q eV fV s * zS Q eV fV S := by
      obtain ⟨hE, hF⟩ := blockAlg_comm hs h2 hsS (zS_mem S)
      rw [zi, ← mul_assoc, hE, mul_assoc, hF, mul_assoc]
    rw [zS, Finset.sum_insert hsS, ← zS, Finset.sum_insert hsS, map_add, ← ih,
      ← zi_mul_zi_add_zi hs h2, add_mul, mul_add, mul_add, hcomm]
    have := add_self h2 (zi Q eV fV s * zS Q eV fV S)
    calc _ = zi Q eV fV s * zi Q eV fV s + zi Q eV fV s +
          (zS Q eV fV S * zS Q eV fV S + zS Q eV fV S) +
          (zi Q eV fV s * zS Q eV fV S + zi Q eV fV s * zS Q eV fV S) := by abel
      _ = _ := by rw [this, add_zero]

end CliffordCenter.CharTwo
