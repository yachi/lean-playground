/-!
# Power-map digraphs do not determine the power graph

For a finite group `G` and an integer `t`, let `Γₜ(G)` be the functional digraph of the power
map `x ↦ xᵗ`. V. H. Fernandes, M. U. Qureshi, R. Reis and M. Ribas,
*On a class of combinatorial group invariants*, arXiv:2609.20516 (2026), compare six equivalence
relations on finite groups. Two of them are

* `G ∼₂ H`: there is a bijection `φ : G → H` with `φ (gᵗ) = φ(g)ᵗ` for all `g` and all `t ∈ ℤ`
  (by their Theorem 1.7 this is equivalent to `G` and `H` having isomorphic power graphs, and to
  isomorphic weighted digraphs of cyclic subgroups);
* `G ∼₅ H`: `Γₜ(G) ≅ Γₜ(H)` for every `t ∈ ℤ`, the isomorphism being allowed to depend on `t`.

Always `∼₂ ⊆ ∼₅`, and they coincide for nilpotent groups (their Theorem 1.8). Their
**Problem 6.1** asks:

> Prove or disprove: there exist finite groups `G, H` such that `G ∼₅ H` but `G ≁₂ H`.

(equivalently, whether the inclusion `P₄ ≤ P₅` is strict, which they record as posed by
M. Larson, *Power maps in finite groups*, Integers 19 (2019) A58).

We show that such groups exist: `G610 = SmallGroup(288, 610)` and `G621 = SmallGroup(288, 621)`
(`answer_problem_6_1`). Both are `(C₃ × C₃) ⋊ K` with `K = (C₂ × C₂ × C₄) ⋊ C₂` of order 32,
where `K` acts on `C₃ × C₃ = ⟨p⟩ × ⟨q⟩` through two sign characters:

* in `G610 = SmallGroup(288,610)` the involution `w` of `K` acts on `A = C₂ × C₂ × C₄ =
  ⟨u⟩ × ⟨v⟩ × ⟨x⟩` by `u ↦ ux², v ↦ v, x ↦ vx`; `x` inverts `p` and `q`, `w` inverts `q`;
* in `G621 = SmallGroup(288,621)` (`K ≅ C₄ × D₈`) `w` acts by `u ↦ uv, v ↦ v, x ↦ x`;
  `x` inverts `p` and `q`, `u` inverts `q`.

`G ∼₅ H` is witnessed by twelve explicit bijections, one for each residue of `t` modulo the
common exponent 12 (`sim5`); they were found by matching the rooted in-trees of the functional
graphs. `G ≁₂ H` (`not_sim2`) follows from an invariant of `∼₂`: say `g` is *special* if `g` has
order 12, exactly 24 elements `h` of order 12 have `h⁴ ∈ {g⁴, g⁸}` (i.e. `⟨g⁴⟩` lies in exactly
six cyclic subgroups of order 12), and the involution `g⁶` has exactly 84 square roots. A
bijection commuting with all power maps preserves being special, `G610` has special elements and
`G621` has none. (In the cyclic-subgroup digraph: in `G610` the order-3 subgroup lying in six
`C₁₂`'s sits under the involution that has 42 cyclic subgroups of order 4 above it, in `G621` it
sits under an involution with only 6.)

A GAP search (`scripts/power-maps/search.g`) over all non-nilpotent groups of order `< 288`
with equal element-order statistics finds no pair with `G ∼₅ H` but `G ≁₂ H`, so 288 is the
least order of a counterexample (for nilpotent groups there is none by Theorem 1.8, and the
element-order statistics, which are a `∼₅` invariant, detect nilpotency).
-/

namespace PowerMaps

open Finset

/-! ### The two relations -/

/-- `G ∼₂ H`: a bijection commuting with every power map. -/
def Sim2 (G H : Type*) [Group G] [Group H] : Prop :=
  ∃ φ : G ≃ H, ∀ (g : G) (t : ℤ), φ (g ^ t) = φ g ^ t

/-- `G ∼₅ H`: for every `t`, the power-map digraphs `x ↦ xᵗ` are isomorphic. -/
def Sim5 (G H : Type*) [Group G] [Group H] : Prop :=
  ∀ t : ℤ, ∃ φ : G ≃ H, ∀ g : G, φ (g ^ t) = φ g ^ t

theorem sim5_of_sim2 {G H : Type*} [Group G] [Group H] (h : Sim2 G H) : Sim5 G H := by
  obtain ⟨φ, hφ⟩ := h
  exact fun t => ⟨φ, fun g => hφ g t⟩

/-! ### An invariant of `∼₂` -/

/-- `g` is *special*: `g⁴ ≠ 1`, `g⁶ ≠ 1`, exactly 24 elements `h` with `h⁶ ≠ 1` have
`h⁴ ∈ {g⁴, g⁸}`, and `g⁶` has exactly 84 square roots. -/
def Special {G : Type*} [Group G] [Fintype G] [DecidableEq G] (g : G) : Prop :=
  g ^ 4 ≠ 1 ∧ g ^ 6 ≠ 1 ∧
    #{h | (h ^ 4 = g ^ 4 ∨ h ^ 4 = g ^ 8) ∧ h ^ 6 ≠ 1} = 24 ∧ #{k | k ^ 2 = g ^ 6} = 84

instance {G : Type*} [Group G] [Fintype G] [DecidableEq G] (g : G) : Decidable (Special g) := by
  unfold Special; infer_instance

/-- A bijection commuting with the power maps `x ↦ xⁿ` (`n ∈ ℕ`) preserves being special. -/
theorem special_iff {G H : Type*} [Group G] [Group H] [Fintype G] [Fintype H] [DecidableEq G]
    [DecidableEq H] (φ : G ≃ H) (hφ : ∀ (g : G) (n : ℕ), φ (g ^ n) = φ g ^ n) (g : G) :
    Special g ↔ Special (φ g) := by
  have h1 : φ 1 = 1 := by simpa using hφ 1 0
  have hne : ∀ x : G, φ x = 1 ↔ x = 1 := fun x => by
    rw [← h1, φ.apply_eq_iff_eq]
  have heq : ∀ x y : G, φ x = φ y ↔ x = y := fun x y => φ.apply_eq_iff_eq
  unfold Special
  have c1 : #{h : G | (h ^ 4 = g ^ 4 ∨ h ^ 4 = g ^ 8) ∧ h ^ 6 ≠ 1} =
      #{h : H | (h ^ 4 = φ g ^ 4 ∨ h ^ 4 = φ g ^ 8) ∧ h ^ 6 ≠ 1} := by
    apply Finset.card_equiv φ
    intro h
    simp only [mem_filter, mem_univ, true_and, ne_eq]
    rw [← hφ h 4, ← hφ g 4, ← hφ g 8, ← hφ h 6, heq, heq, hne]
  have c2 : #{k : G | k ^ 2 = g ^ 6} = #{k : H | k ^ 2 = φ g ^ 6} := by
    apply Finset.card_equiv φ
    intro k
    simp only [mem_filter, mem_univ, true_and]
    rw [← hφ k 2, ← hφ g 6, heq]
  simp only [ne_eq]
  rw [c1, c2, ← hφ g 4, ← hφ g 6, hne, hne]

/-! ### The groups -/

/-- `A = C₂ × C₂ × C₄ = ⟨u⟩ × ⟨v⟩ × ⟨x⟩`, written additively in coordinates. -/
abbrev A : Type := Multiplicative (ZMod 2 × ZMod 2 × ZMod 4)

/-- `C₂ = ⟨w⟩`. -/
abbrev C2 : Type := Multiplicative (ZMod 2)

/-- `C₃ × C₃ = ⟨p⟩ × ⟨q⟩`. -/
abbrev N : Type := Multiplicative (ZMod 3 × ZMod 3)

instance : DecidableEq (MulAut A) := fun f g =>
  decidable_of_iff (∀ x, f x = g x) MulEquiv.ext_iff.symm

instance : DecidableEq (MulAut N) := fun f g =>
  decidable_of_iff (∀ x, f x = g x) MulEquiv.ext_iff.symm

/-- For `SmallGroup(288,610)`: `w : u ↦ ux², v ↦ v, x ↦ vx`. -/
def w610 : MulAut A where
  toFun n := Multiplicative.ofAdd (n.toAdd.1, n.toAdd.2.1 + (n.toAdd.2.2.val : ZMod 2),
    n.toAdd.2.2 + 2 * (n.toAdd.1.val : ZMod 4))
  invFun n := Multiplicative.ofAdd (n.toAdd.1, n.toAdd.2.1 + (n.toAdd.2.2.val : ZMod 2),
    n.toAdd.2.2 + 2 * (n.toAdd.1.val : ZMod 4))
  left_inv := by decide +kernel
  right_inv := by decide +kernel
  map_mul' := by decide +kernel

/-- For `SmallGroup(288,621)`: `w : u ↦ uv, v ↦ v, x ↦ x`. -/
def w621 : MulAut A where
  toFun n := Multiplicative.ofAdd (n.toAdd.1, n.toAdd.2.1 + n.toAdd.1, n.toAdd.2.2)
  invFun n := Multiplicative.ofAdd (n.toAdd.1, n.toAdd.2.1 + n.toAdd.1, n.toAdd.2.2)
  left_inv := by decide +kernel
  right_inv := by decide +kernel
  map_mul' := by decide +kernel

/-- The action of `C₂ = ⟨w⟩` on `A` for `G610`. -/
def actK610 : C2 →* MulAut A where
  toFun e := if e.toAdd = 1 then w610 else 1
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

/-- The action of `C₂ = ⟨w⟩` on `A` for `G621`. -/
def actK621 : C2 →* MulAut A where
  toFun e := if e.toAdd = 1 then w621 else 1
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

/-- `K610 = A ⋊ C₂ = SmallGroup(32,30)`. -/
abbrev K610 : Type := A ⋊[actK610] C2

/-- `K621 = A ⋊ C₂ ≅ C₄ × D₈ = SmallGroup(32,25)`. -/
abbrev K621 : Type := A ⋊[actK621] C2

instance : Fintype K610 := Fintype.ofEquiv _ SemidirectProduct.equivProd.symm
instance : Fintype K621 := Fintype.ofEquiv _ SemidirectProduct.equivProd.symm

instance : DecidableEq K610 := fun x y =>
  decidable_of_iff (x.left = y.left ∧ x.right = y.right) SemidirectProduct.ext_iff.symm
instance : DecidableEq K621 := fun x y =>
  decidable_of_iff (x.left = y.left ∧ x.right = y.right) SemidirectProduct.ext_iff.symm

/-- Inversion of `p`. -/
def negP : MulAut N where
  toFun n := Multiplicative.ofAdd (-n.toAdd.1, n.toAdd.2)
  invFun n := Multiplicative.ofAdd (-n.toAdd.1, n.toAdd.2)
  left_inv := by decide +kernel
  right_inv := by decide +kernel
  map_mul' := by decide +kernel

/-- Inversion of `q`. -/
def negQ : MulAut N where
  toFun n := Multiplicative.ofAdd (n.toAdd.1, -n.toAdd.2)
  invFun n := Multiplicative.ofAdd (n.toAdd.1, -n.toAdd.2)
  left_inv := by decide +kernel
  right_inv := by decide +kernel
  map_mul' := by decide +kernel

/-- `K610` acts on `N`: `x` inverts `p` and `q`, `w` inverts `q`. -/
def act610 : K610 →* MulAut N where
  toFun k := (if (k.left.toAdd.2.2.val : ZMod 2) = 1 then negP else 1) *
    (if (k.left.toAdd.2.2.val : ZMod 2) + k.right.toAdd = 1 then negQ else 1)
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

/-- `K621` acts on `N`: `x` inverts `p` and `q`, `u` inverts `q`. -/
def act621 : K621 →* MulAut N where
  toFun k := (if (k.left.toAdd.2.2.val : ZMod 2) = 1 then negP else 1) *
    (if (k.left.toAdd.2.2.val : ZMod 2) + k.left.toAdd.1 = 1 then negQ else 1)
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

/-- `SmallGroup(288, 610)`. -/
abbrev G610 : Type := N ⋊[act610] K610

/-- `SmallGroup(288, 621)`. -/
abbrev G621 : Type := N ⋊[act621] K621

instance : Fintype G610 := Fintype.ofEquiv _ SemidirectProduct.equivProd.symm
instance : Fintype G621 := Fintype.ofEquiv _ SemidirectProduct.equivProd.symm

instance : DecidableEq G610 := fun x y =>
  decidable_of_iff (x.left = y.left ∧ x.right = y.right) SemidirectProduct.ext_iff.symm
instance : DecidableEq G621 := fun x y =>
  decidable_of_iff (x.left = y.left ∧ x.right = y.right) SemidirectProduct.ext_iff.symm

theorem card_G610 : Fintype.card G610 = 288 := by
  simp [Fintype.card_congr SemidirectProduct.equivProd]

theorem card_G621 : Fintype.card G621 = 288 := by
  simp [Fintype.card_congr SemidirectProduct.equivProd]

/-! ### `G610 ≁₂ G621` -/

/-- `G610` has a special element (`p u w`, of order 12). -/
theorem special_G610 : ∃ g : G610, Special g :=
  ⟨⟨Multiplicative.ofAdd (1, 0), ⟨Multiplicative.ofAdd (1, 0, 0), Multiplicative.ofAdd 1⟩⟩,
    by decide +kernel⟩

/-- `G621` has no special element. -/
theorem not_special_G621 : ∀ g : G621, ¬ Special g := by decide +kernel

theorem not_sim2 : ¬ Sim2 G610 G621 := by
  rintro ⟨φ, hφ⟩
  obtain ⟨g, hg⟩ := special_G610
  exact not_special_G621 (φ g) ((special_iff φ (fun g n => by exact_mod_cast hφ g n) g).1 hg)

/-! ### `G610 ∼₅ G621` -/

/-- Coordinates of the `i`-th element of `G610` (`0 ≤ i < 288`). -/
def elt610 (i : ℕ) : G610 :=
  ⟨Multiplicative.ofAdd ((i / 96 : ℕ), (i / 32 % 3 : ℕ)),
    ⟨Multiplicative.ofAdd ((i / 16 % 2 : ℕ), (i / 8 % 2 : ℕ), (i / 2 % 4 : ℕ)),
      Multiplicative.ofAdd ((i % 2 : ℕ) : ZMod 2)⟩⟩

/-- Coordinates of the `i`-th element of `G621`. -/
def elt621 (i : ℕ) : G621 :=
  ⟨Multiplicative.ofAdd ((i / 96 : ℕ), (i / 32 % 3 : ℕ)),
    ⟨Multiplicative.ofAdd ((i / 16 % 2 : ℕ), (i / 8 % 2 : ℕ), (i / 2 % 4 : ℕ)),
      Multiplicative.ofAdd ((i % 2 : ℕ) : ZMod 2)⟩⟩

/-- Index of an element of `G610`. -/
def idx610 (g : G610) : ℕ :=
  ((((g.left.toAdd.1.val * 3 + g.left.toAdd.2.val) * 2 + g.right.left.toAdd.1.val) * 2 +
    g.right.left.toAdd.2.1.val) * 4 + g.right.left.toAdd.2.2.val) * 2 + g.right.right.toAdd.val

/-- Index of an element of `G621`. -/
def idx621 (g : G621) : ℕ :=
  ((((g.left.toAdd.1.val * 3 + g.left.toAdd.2.val) * 2 + g.right.left.toAdd.1.val) * 2 +
    g.right.left.toAdd.2.1.val) * 4 + g.right.left.toAdd.2.2.val) * 2 + g.right.right.toAdd.val

