/-- `Φ_r : G610 → G621`, the isomorphism `Γ_r(G610) ≅ Γ_r(G621)`. -/
def phi (r : Fin 12) (g : G610) : G621 := elt621 ((tab.getD r []).getD (idx610 g) 0)

/-- The inverse of `Φ_r`. -/
def psi (r : Fin 12) (g : G621) : G610 := elt610 ((itab.getD r []).getD (idx621 g) 0)

theorem psi_phi : ∀ (r : Fin 12) (g : G610), psi r (phi r g) = g := by decide +kernel

theorem phi_psi : ∀ (r : Fin 12) (g : G621), phi r (psi r g) = g := by decide +kernel

/-- `Φ_r` as a bijection. -/
def phiEquiv (r : Fin 12) : G610 ≃ G621 := ⟨phi r, psi r, psi_phi r, phi_psi r⟩

/-- `Φ_r (gʳ) = Φ_r(g)ʳ`. -/
theorem phi_pow : ∀ (r : Fin 12) (g : G610), phi r (g ^ (r : ℕ)) = phi r g ^ (r : ℕ) := by
  decide +kernel

theorem pow_twelve_G610 : ∀ g : G610, g ^ 12 = 1 := by decide +kernel

theorem pow_twelve_G621 : ∀ g : G621, g ^ 12 = 1 := by decide +kernel

theorem sim5 : Sim5 G610 G621 := by
  intro t
  have ht : 0 ≤ t % 12 := Int.emod_nonneg t (by norm_num)
  have ht' : t % 12 < 12 := Int.emod_lt_of_pos t (by norm_num)
  set r : ℕ := (t % 12).toNat with hr
  have hrt : ((r : ℕ) : ℤ) = t % 12 := Int.toNat_of_nonneg ht
  have hr12 : r < 12 := by omega
  have key : ∀ {G : Type} [Group G], (∀ g : G, g ^ 12 = 1) → ∀ g : G, g ^ t = g ^ r := by
    intro G _ h g
    rw [zpow_eq_zpow_emod' t (h g), Nat.cast_ofNat, ← hrt, zpow_natCast]
  refine ⟨phiEquiv ⟨r, hr12⟩, fun g => ?_⟩
  rw [key pow_twelve_G610, key pow_twelve_G621]
  exact phi_pow ⟨r, hr12⟩ g

/-- **Answer to Fernandes–Qureshi–Reis–Ribas, Problem 6.1.** There are finite groups `G, H`
(of order 288) with `Γₜ(G) ≅ Γₜ(H)` for every `t ∈ ℤ` but with no bijection commuting with all
power maps (equivalently, with non-isomorphic power graphs). -/
theorem answer_problem_6_1 : Sim5 G610 G621 ∧ ¬ Sim2 G610 G621 := ⟨sim5, not_sim2⟩

end PowerMaps
